    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@repository.TranslateWeb("Close")"></button>
                <div class="auth-icon"><span class="fa-solid fa-key"></span></div>
                <div class="auth-brand">@repository.Configuration.WebProductName</div>
                <h1 class="auth-title">@repository.TranslateWeb("Change your password")</h1>
                <div id="change-password-error" class="alert alert-danger d-none" role="alert"></div>
                <form id="change-password-form" autocomplete="on">
                    <div class="mb-3">
                        <label for="password-change">@repository.TranslateWeb("Enter your current password")</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="password-change" name="password-change" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary auth-password-toggle" tabindex="-1" title="@repository.TranslateWeb("Show password")" aria-label="@repository.TranslateWeb("Show password")"><span class="fa-regular fa-eye"></span></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="password-change1">@repository.TranslateWeb("Enter your new password")</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="password-change1" name="password-change1" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary auth-password-toggle" tabindex="-1" title="@repository.TranslateWeb("Show password")" aria-label="@repository.TranslateWeb("Show password")"><span class="fa-regular fa-eye"></span></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="password-change2">@repository.TranslateWeb("Confirm your new password")</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="password-change2" name="password-change2" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary auth-password-toggle" tabindex="-1" title="@repository.TranslateWeb("Show password")" aria-label="@repository.TranslateWeb("Show password")"><span class="fa-regular fa-eye"></span></button>
                        </div>
                    </div>
                    <button id="change-password-submit" type="submit" class="btn btn-primary w-100">@repository.TranslateWeb("Change password")</button>
                </form>
            </div>
        </div>
    </div>
</div>


<!-- Folder Modal -->
<div id="folder-dialog" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false">
    <div class="modal-dialog">
        <div class="modal-content" style="top:60px">
            <div class="modal-header">
                <h4 class="modal-title">@repository.TranslateWeb("Manage Folders")</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 d-flex flex-column flex-sm-row gap-2">
                    <input class="form-control" id="create-folder-name" placeholder="@repository.TranslateWeb("New folder name")" />
                    <button id="folder-create" type="button" class="btn btn-primary flex-shrink-0 text-nowrap">@repository.TranslateWeb("Create new folder")</button>
                </div>
                <div class="mb-3 d-flex flex-column flex-sm-row gap-2">
                    <input class="form-control" id="rename-folder-name" placeholder="@repository.TranslateWeb("New folder path")" />
                    <button id="folder-rename" type="button" class="btn btn-primary flex-shrink-0 text-nowrap">@repository.TranslateWeb("Rename or move folder")</button>
                </div>
                <div class="mb-3">
                    <button id="folder-delete" type="button" class="btn btn-primary">@repository.TranslateWeb("Delete folder")</button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@repository.TranslateWeb("Close")</button>
            </div>
        </div>
    </div>
</div>


<!--Wait Dialog: no "fade" on purpose. It is shown/hidden purely programmatically
    (login, search, execute, "Reload and execute"...). With the fade transition, a fast
    round-trip calls HideModal before Bootstrap 5 finishes the show transition; hide()
    then early-returns mid-transition and leaves the backdrop orphaned, dimming and
    blocking the screen. Without fade, show/hide are synchronous so the backdrop is
    always torn down. -->
<div class="modal" id="wait-dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <span class="spinner-border text-primary" role="status" aria-hidden="true"></span>
                <span class="wait-dialog-label">@repository.TranslateWeb("Please wait")...</span>
            </div>
        </div>
    </div>
</div>

<!-- Message Dialog -->
<div id="message-dialog" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" style="z-index:25000;">
    <div class="modal-dialog">
        <div class="modal-content" style="top: 60px;">
            <div class="modal-header">
                <h4 id="message-title" class="modal-title"></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@repository.TranslateWeb("Close")"></button>
            </div>
            <div class="modal-body">
                <span id="message-text"></span>
            </div>
            <div class="modal-footer">
                <button id="message-cancel-button" type="button" class="btn btn-secondary" data-bs-dismiss="modal">@repository.TranslateWeb("Cancel")</button>
                <button id="message-ok-button" type="button" class="btn btn-primary">@repository.TranslateWeb("OK")</button>
            </div>
        </div>
    </div>
</div>

<!-- File Name Dialog -->
<div id="report-name-dialog" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" style="z-index:25000;">
    <div class="modal-dialog">
        <div class="modal-content" style="top:60px">
            <div class="modal-header">
                <h4 class="modal-title">@repository.TranslateWeb("Enter your new file name")</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@repository.TranslateWeb("Close")"></button>
            </div>
            <div class="modal-body">
                <input id="report-name" type="text" class="form-control" placeholder="@repository.TranslateReport("New report")" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@repository.TranslateWeb("Cancel")</button>
                <button id="report-name-save" type="button" class="btn btn-primary">@repository.TranslateWeb("Save")</button>
            </div>
        </div>
    </div>
</div>


<!-- Profile Dialog -->
<div id="profile-dialog" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">@repository.TranslateWeb("Profile information")</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@repository.TranslateWeb("Close")"></button>
            </div>
            <div class="modal-body" style="max-height:90vh;overflow-y:auto;">

                <ul id="profile-tabs" class="nav nav-tabs mb-3 d-none" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button id="profile-tab-general-button" class="nav-link active" data-bs-toggle="tab" data-bs-target="#profile-tab-general" type="button" role="tab" aria-controls="profile-tab-general" aria-selected="true">@repository.TranslateWeb("Profile")</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button id="profile-tab-mcp-button" class="nav-link" data-bs-toggle="tab" data-bs-target="#profile-tab-mcp" type="button" role="tab" aria-controls="profile-tab-mcp" aria-selected="false"><i class="fa-solid fa-plug me-1"></i>@repository.TranslateWeb("MCP access")</button>
                    </li>
                </ul>

                <div class="tab-content">
                <div id="profile-tab-general" class="tab-pane fade show active" role="tabpanel" aria-labelledby="profile-tab-general-button">
                <div class="config-input-row">
                    <span class="config-input-label">@repository.TranslateWeb("User name")</span>
                    <input class="form-control config-input-field" id="profile-user" disabled="disabled" />
                </div>
                <div class="config-input-row">
                    <span class="config-input-label">@repository.TranslateWeb("User groups")</span>
                    <textarea rows="3" class="form-control config-input-field" id="profile-groups" disabled="disabled"></textarea>
                </div>
                <div id="profile-change-password-option" class="config-input-row">
                    <span class="config-input-label">@repository.TranslateWeb("Change password")</span>
                    <button id="profile-change-password" type="button" class="btn btn-secondary">@repository.TranslateWeb("Change password")</button>
                </div>

                <hr class="edit-profile" />

                <div class="config-input-row edit-profile">
                    <span class="config-input-label">@repository.TranslateWeb("Culture")</span>
                    <div class="config-input-field">
                        <select id="culture-select" data-live-search="true" data-container="body" data-width="100%"></select>
                    </div>
                </div>

                <div class="config-input-row edit-profile">
                    <span class="config-input-label">@repository.TranslateWeb("Report execution mode")</span>
                    <div class="config-input-field">
                        <select id="executionmode-select" data-container="body" data-width="100%"></select>
                    </div>
                </div>

                <div class="config-input-row edit-profile">
                    <span class="config-input-label">@repository.TranslateWeb("On startup")</span>
                    <div class="config-input-field">
                        <select id="onstartup-select" data-container="body" data-width="100%"></select>
                    </div>
                </div>

                <div class="config-input-row edit-profile">
                    <span class="config-input-label">@repository.TranslateWeb("Startup report name")</span>
                    <input class="form-control config-input-field" id="onstartup-reportname" />
                </div>

                <div class="config-input-row">
                    <span id="default-connections-title" class="config-input-label">@repository.TranslateWeb("Data source connections")</span>
                </div>
                <div class="config-input-row">
                    <div id="default-connections" class="config-input-field"></div>
                </div>
                </div>

                <div id="profile-tab-mcp" class="tab-pane fade" role="tabpanel" aria-labelledby="profile-tab-mcp-button">
                <div id="profile-mcp">
                    <div class="form-text mb-2">@repository.TranslateWeb("A personal access token connects an AI client (Claude, Copilot, Cursor...) to the AI agents with your rights: set it in the header 'Authorization: Bearer <token>' of the MCP server URL.")</div>
                    <table id="mcp-tokens-table" class="table table-sm align-middle mb-2">
                        <thead>
                            <tr>
                                <th>@repository.TranslateWeb("Name")</th>
                                <th>@repository.TranslateWeb("Created")</th>
                                <th>@repository.TranslateWeb("Expires")</th>
                                <th>@repository.TranslateWeb("Last use")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <div class="input-group input-group-sm flex-nowrap mb-2">
                        <input id="mcp-token-name" class="form-control" style="width:1%;" maxlength="60" placeholder="@repository.TranslateWeb("Token name (e.g. Claude Code)")" />
                        <select id="mcp-token-days" class="form-select" style="flex:0 0 8rem;width:8rem;"></select>
                        <button id="mcp-token-create" type="button" class="btn btn-primary">@repository.TranslateWeb("Create")</button>
                    </div>
                    <div id="mcp-token-error" class="alert alert-danger d-none p-2"></div>
                    <div id="mcp-token-new" class="alert alert-warning d-none p-2">
                        <div class="mb-1">@repository.TranslateWeb("Copy this token now: it will not be shown again.")</div>
                        <div class="input-group input-group-sm flex-nowrap">
                            <input id="mcp-token-value" class="form-control font-monospace" style="width:1%;" readonly="readonly" />
                            <button id="mcp-token-copy" type="button" class="btn btn-secondary" title="@repository.TranslateWeb("Copy")"><i class="fa fa-copy"></i></button>
                        </div>
                    </div>
                    <div class="form-text">@repository.TranslateWeb("MCP server URLs of your agents:")</div>
                    <ul id="mcp-agents" class="list-unstyled small mb-0"></ul>
                    <div id="mcp-authorizations" class="mt-3 d-none">
                        <div class="fw-semibold small">@repository.TranslateWeb("Authorized applications")</div>
                        <div class="form-text mb-2">@repository.TranslateWeb("AI clients connected with OAuth: add the MCP server URL of an agent as a connector in your AI client (e.g. claude.ai or Claude Desktop) and log in to authorize it.")</div>
                        <table id="mcp-authorizations-table" class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@repository.TranslateWeb("Application")</th>
                                    <th>@repository.TranslateWeb("Agent")</th>
                                    <th>@repository.TranslateWeb("Authorized")</th>
                                    <th>@repository.TranslateWeb("Expires")</th>
                                    <th>@repository.TranslateWeb("Last use")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <div id="mcp-authorizations-none" class="small text-muted">@repository.TranslateWeb("No application authorized.")</div>
                    </div>
                </div>
                </div>
                </div>
            </div>
            <div class="modal-footer">
                <button id="profile-cancel" type="button" class="btn btn-secondary edit-profile" data-bs-dismiss="modal">@repository.TranslateWeb("Cancel")</button>
                <button id="profile-save" type="button" class="btn btn-primary edit-profile">@repository.TranslateWeb("Save")</button>
                <button id="profile-close" type="button" class="btn btn-secondary" data-bs-dismiss="modal">@repository.TranslateWeb("Close")</button>
            </div>
        </div>
    </div>
</div>

<!-- My schedules Dialog: web schedules of the user -->
<div id="webschedules-dialog" class="modal fade" tabindex="-1" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><i class="fa-solid fa-calendar-days me-2"></i>@repository.TranslateWeb("My schedules")</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@repository.TranslateWeb("Close")"></button>
            </div>
            <div class="modal-body" style="max-height:80vh;overflow-y:auto;">
                <div class="form-text mb-2">@repository.TranslateWeb("To schedule a report, open the list of its views and outputs and choose 'Schedule...'.")</div>
