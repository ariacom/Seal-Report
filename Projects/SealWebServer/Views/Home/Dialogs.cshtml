@using Seal.Model
@using Seal.Helpers
@using SealWebServer.Controllers
@using SealWebServer.Models.Configuration
@{
    WebMainModel model = Model as WebMainModel;
    Repository repository = model.Repository;
    var authenticationConfig = ViewData["AuthenticationConfig"] as Authentication;
}


<!-- Authentication dialogs (login, two-factor, password reset/change): shared "auth-modal" card layout, see sealweb.css.
     Each dialog is a real <form> with autocomplete attributes so that browser password managers can fill and save. -->

<!-- Login Modal -->
<div id="login-modal" class="modal fade auth-modal" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" style="z-index:25000;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <div class="auth-icon"><span class="fa-solid fa-right-to-bracket"></span></div>
                <div class="auth-brand">@repository.Configuration.WebProductName</div>
                <h1 class="auth-title">@repository.TranslateWeb("Login")</h1>
                <div id="login-modal-info" class="alert alert-info" role="status" data-text="@repository.TranslateWeb("You have been signed out.")"></div>
                <div id="login-modal-error" class="alert alert-danger" role="alert"></div>
                @if (!(authenticationConfig?.IsUnique() ?? false))
                {
                    <form id="login-form" autocomplete="on">
                        @if (!(authenticationConfig?.HideLoginPassword ?? false))
                        {
                            <div class="mb-3">
                                <label for="username">@repository.TranslateWeb("User name")</label>
                                <input type="text" class="form-control" id="username" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" />
                            </div>
                            <div class="mb-2">
                                <label for="password">@repository.TranslateWeb("Password")</label>
                                <div class="input-group">
                                    <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" />
                                    <button type="button" class="btn btn-outline-secondary auth-password-toggle" tabindex="-1" title="@repository.TranslateWeb("Show password")" aria-label="@repository.TranslateWeb("Show password")"><span class="fa-regular fa-eye"></span></button>
                                </div>
                            </div>
                            <div class="auth-link text-end mb-3">
                                <a id="login-password-reset" href="">@repository.TranslateWeb("Forget your password ?")</a>
                            </div>
                        }
                        <button id="login-modal-submit" type="submit" class="btn btn-primary w-100">@repository.TranslateWeb("Login")</button>
                    </form>
                }
                @if (authenticationConfig?.Enabled ?? false)
                {
                    @if (!authenticationConfig.IsUnique())
                    {
                        <div class="auth-divider"><span>@repository.TranslateWeb("or")</span></div>
                    }
                    <a class="btn btn-outline-secondary w-100" href="@Url.Action("Login", "Home")">@repository.TranslateWeb("Login") @authenticationConfig.Name</a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Security Code Modal -->
<div id="security-modal" class="modal fade auth-modal" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" style="z-index:26000;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <div class="auth-icon"><span class="fa-solid fa-shield-halved"></span></div>
                <div class="auth-brand">@repository.Configuration.WebProductName</div>
                <h1 class="auth-title">@repository.TranslateWeb("Two-Factor Authentication")</h1>
                <div id="security-code-message" class="alert alert-warning" role="status"></div>
                <div id="security-modal-error" class="alert alert-danger" role="alert"></div>
                <form id="security-form" autocomplete="off">
                    <div class="mb-3">
                        <label for="securitycode">@repository.TranslateWeb("Security code")</label>
                        <input type="text" class="form-control" id="securitycode" name="securitycode" autocomplete="one-time-code" autocapitalize="none" spellcheck="false" />
                    </div>
                    <button id="security-modal-submit" type="submit" class="btn btn-primary w-100">@repository.TranslateWeb("Login")</button>
                </form>
                <div class="auth-link text-center mt-3">
                    <a class="security-back-to-login" href="">@repository.TranslateWeb("Back to login with user name and password")</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Password Recover Modal -->
<div id="password-reset-modal" class="modal fade auth-modal" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" style="z-index:25000;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <div class="auth-icon"><span class="fa-solid fa-key"></span></div>
                <div class="auth-brand">@repository.Configuration.WebProductName</div>
                <h1 class="auth-title">@repository.TranslateWeb("Reset your password")</h1>
                <form id="password-reset-form" autocomplete="on">
                    <div class="mb-3">
                        <label for="password-reset-name">@repository.TranslateWeb("Enter your user identifier or email")</label>
                        <input type="text" class="form-control" id="password-reset-name" name="password-reset-name" autocomplete="username" autocapitalize="none" spellcheck="false" />
                    </div>
                    <button id="password-reset-submit" type="submit" class="btn btn-primary w-100">@repository.TranslateWeb("Reset password")</button>
                </form>
                <div class="auth-link text-center mt-3">
                    <a class="security-back-to-login" href="">@repository.TranslateWeb("Back to login with user name and password")</a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Password Recover Modal2 -->
<div id="password-reset-modal2" class="modal fade auth-modal" role="dialog" data-bs-backdrop="static" data-bs-keyboard="false" data-bs-focus="false" style="z-index:25000;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@repository.TranslateWeb("Close")"></button>
                <div class="auth-icon"><span class="fa-solid fa-key"></span></div>
                <div class="auth-brand">@repository.Configuration.WebProductName</div>
                <h1 class="auth-title">@repository.TranslateWeb("Re-init your password")</h1>
                <div id="password-reset-error2" class="alert alert-danger d-none" role="alert"></div>
                <form id="password-reset-form2" autocomplete="on">
                    <div class="mb-3">
                        <label for="password-reset1">@repository.TranslateWeb("Enter your new password")</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="password-reset1" name="password-reset1" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary auth-password-toggle" tabindex="-1" title="@repository.TranslateWeb("Show password")" aria-label="@repository.TranslateWeb("Show password")"><span class="fa-regular fa-eye"></span></button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="password-reset2">@repository.TranslateWeb("Confirm your new password")</label>
                        <div class="input-group">
                            <input type="password" class="form-control" id="password-reset2" name="password-reset2" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary auth-password-toggle" tabindex="-1" title="@repository.TranslateWeb("Show password")" aria-label="@repository.TranslateWeb("Show password")"><span class="fa-regular fa-eye"></span></button>
                        </div>
                    </div>
                    <button id="password-reset-submit2" type="submit" class="btn btn-primary w-100">@repository.TranslateWeb("Change password")</button>
