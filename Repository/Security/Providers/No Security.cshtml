@using Seal.Model;
@{
    SecurityProvider provider = Model;

    provider.Script = @"@{
    SecurityUser user = Model;
	//No security: use the default security group
	//With 'Allow access without account', every user is a guest (user.IsGuest): group Guest
    user.Name = """";
	if (user.IsGuest) {
		user.Name = ""Guest"";
		user.AddSecurityGroup(""Guest"");
	}
	else user.AddDefaultSecurityGroup();
}";    
}
