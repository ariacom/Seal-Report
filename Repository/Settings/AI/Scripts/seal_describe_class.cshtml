@using System.Text.Json
@using Seal.AI
@{
    AIToolConfiguration tool = Model;
    var args = JsonDocument.Parse(tool.CurrentToolCall.Arguments).RootElement;
    var name = args.GetProperty("name").GetString();
    tool.CurrentToolCall.LogMessage($"Starting tool '{tool.CurrentToolCall.Name}' (class: {name})..");

    // Reflection on the classes serialized in a report: XML elements, types, defaults, enumerations, descriptions and code levels
    tool.ExecResult = AIKnowledge.DescribeClass(name);
    tool.CurrentToolCall.LogMessage($"Tool '{tool.CurrentToolCall.Name}' finished.");
}
