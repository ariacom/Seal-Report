@using System.IO
@using System.Linq
@using System.Text
@using System.Threading
@using System.Text.Json
@using Seal.Model
@using Seal.AI
@{
    AIToolConfiguration tool = Model;
    var repo            = Repository.Instance;
    var securityContext = tool.CurrentToolCall.SecurityContext;
    if (securityContext == null) { tool.ExecResult = "Error: no security context available."; return; }
    if (!securityContext.SqlModel) { tool.ExecResult = "Error: you are not allowed to create reports from raw SQL (SQL Models are disabled for your security group). Use the metadata route (report_create_from_xml) instead if it can express the request; otherwise tell the user in one sentence that an administrator can enable 'SQL models' for their security group."; return; }

    var args             = JsonDocument.Parse(tool.CurrentToolCall.Arguments).RootElement;
    var path             = Seal.Helpers.FileHelper.ConvertOSFilePath(args.GetProperty("path").GetString());
    tool.CurrentToolCall.LogMessage($"Starting tool '{tool.CurrentToolCall.Name}' (path: {path})..");
    var displayName      = args.GetProperty("display_name").GetString();
    var sql              = args.GetProperty("sql").GetString();
    var sourceGuid       = args.TryGetProperty("source_guid",        out var snp) ? snp.GetString() : null;
    var modelName        = args.TryGetProperty("model_name",        out var mnp) ? mnp.GetString() : null;
    var description      = args.TryGetProperty("description",       out var dp)  ? dp.GetString()  : null;
    var keepColumnNames  = args.TryGetProperty("keep_column_names", out var kp)  && kp.GetBoolean();
    var overwrite        = args.TryGetProperty("overwrite",         out var op)  && op.GetBoolean();
    var noRecordLimit    = args.TryGetProperty("no_record_limit",   out var nlp) && nlp.ValueKind == JsonValueKind.True;
    // Reports created by the AI agent are limited by default
    const int defaultMaxNumberOfRecords = 5000;

    var roots = new System.Collections.Generic.Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Reports"]  = repo.ReportsFolder,
        ["Personal"] = repo.GetPersonalFolder(securityContext),
    };

    // A folder is not a report path: 'Personal\' would resolve outside the user's folders and end in a misleading 'write access denied'
    if (string.IsNullOrWhiteSpace(path) || path.EndsWith(Path.DirectorySeparatorChar) || roots.ContainsKey(path))
        { tool.ExecResult = $"Error: 'path' must end with a report file name, for instance '{path.TrimEnd(Path.DirectorySeparatorChar)}{Path.DirectorySeparatorChar}my_report.srex' (got the folder '{path}'). You have not been denied access: call the tool again with a file name."; return; }

    // Resolve destination full path
    string fullPath = null;
    foreach (var kv in roots)
        if (path.StartsWith(kv.Key + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
            { fullPath = Path.Combine(kv.Value, path.Substring(kv.Key.Length + 1)); break; }
    if (fullPath == null) fullPath = Path.Combine(repo.ReportsFolder, path);
    if (!fullPath.EndsWith("." + Repository.SealReportFileExtension, StringComparison.OrdinalIgnoreCase))
        fullPath += "." + Repository.SealReportFileExtension;

    if (File.Exists(fullPath) && !overwrite)
        { tool.ExecResult = $"Error: '{path}' already exists. Set overwrite=true to replace it."; return; }


    if (!securityContext.HasFolderRight(Path.GetDirectoryName(fullPath), (int)FolderRight.Edit))
        { tool.ExecResult = $"Error: write access denied to '{path}'."; return; }

    try
    {
        // Create the report shell (sources, default model, default HTML view)
        var report = Report.Create(repo);
        report.FilePath    = fullPath;
        report.DisplayName = displayName;
        if (!string.IsNullOrEmpty(description)) report.SetMetaInfo("Description", description);

        // Pick the right ReportSource by MetaSource GUID
        ReportSource reportSource = null;
        if (!string.IsNullOrEmpty(sourceGuid))
        {
            reportSource = report.Sources.FirstOrDefault(s => s.MetaSourceGUID == sourceGuid);
            if (reportSource == null)
                { tool.ExecResult = $"Error: no source with GUID '{sourceGuid}' found. Available GUIDs: {string.Join(", ", report.Sources.Select(s => s.MetaSourceGUID))}"; return; }
        }
        else
        {
            reportSource = report.Sources.FirstOrDefault(s => s.IsDefault) ?? report.Sources.FirstOrDefault();
        }
        report.Sources.RemoveAll(i => i != reportSource);

        // Configure the default model as a SQL model
        var model = report.Models[0];
        model.SourceGUID = reportSource.GUID;
        if (!string.IsNullOrEmpty(modelName)) model.Name = modelName;
        model.Table                  = MetaTable.Create();
        model.Table.DynamicColumns   = true;
        model.Table.KeepColumnNames  = keepColumnNames;
        model.Table.Sql              = sql;
        model.RefreshMetaTable(true);
        if (!noRecordLimit) model.MaxNumberOfRecords = defaultMaxNumberOfRecords;

        //Add elements
        foreach (var col in model.Table.Columns)
        {
            var element = ReportElement.Create();
            element.Source = model.Source;
            element.Report = model.Report;
            element.Model = model;
            element.MetaColumnGUID = col.GUID;
            element.MetaColumn = col;
            element.Name = col.Name;
            element.PivotPosition = PivotPosition.Row;
            element.SetDefaults();
            model.Elements.Add(element);
        }

        var dir = Path.GetDirectoryName(fullPath);
        if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
        report.SaveToFile(fullPath);

        tool.ExecResult = $"Created: {path}";
        if (!noRecordLimit)
            tool.ExecResult += $"\r\nNote: the result is limited to {defaultMaxNumberOfRecords} records (default limit of the reports created by the AI agent). Mention it to the user.";

        // --- Test execution: run the saved report with its default criteria values, so that the caller sees
        // what the user will get (row count, errors) before announcing it: a saved report is not a working report ---
        const int testTimeoutSeconds = 30;
        var test = new StringBuilder();
        try
        {
            var testReport = Report.LoadFromFile(fullPath, repo);
            if (!string.IsNullOrEmpty(testReport.LoadErrors))
                test.Append($"TEST FAILED: the report does not load: {testReport.LoadErrors}");
            else
            {
                testReport.SkipExternalViewer = true;
                var watch = System.Diagnostics.Stopwatch.StartNew();
                new ReportExecution() { Report = testReport }.Execute();
                var timedOut = false;
                while (testReport.Status != ReportStatus.Executed && !testReport.HasErrors && !testReport.Cancel)
                {
                    if (tool.CurrentToolCall.CancelOperation?.Cancel == true) { testReport.Cancel = true; break; }
                    if (watch.Elapsed.TotalSeconds > testTimeoutSeconds) { testReport.Cancel = true; timedOut = true; break; }
                    Thread.Sleep(200);
                }

                if (timedOut)
                    test.Append($"TEST WARNING: the execution was still running after {testTimeoutSeconds} s and was cancelled: the query is too broad (or too slow). Restrict it, then call the tool again with overwrite=true.");
                else if (testReport.HasErrors)
                    test.Append($"TEST FAILED: the report does not execute: {testReport.ExecutionErrors}\r\nThe file is saved but broken: fix the SQL and call the tool again with overwrite=true. Never present this report as working.");
                else if (!testReport.Cancel)
                {
                    test.Append($"Test execution ({watch.Elapsed.TotalSeconds:0.0} s):");
                    var noRow = false;
                    foreach (var m in testReport.ExecutionModels)
                    {
                        var rows = m.ResultTable == null ? 0 : m.ResultTable.Rows.Count;
                        test.Append($"\r\n- model '{m.Name}': {rows} row(s)");
                        if (m.MaxNumberOfRecords > 0 && rows >= m.MaxNumberOfRecords) test.Append($" (the limit of {m.MaxNumberOfRecords} records is reached: the real result is larger)");
                        if (rows == 0) noRow = true;
                        else
                        {
                            // Sample only: drop the truncation note, which would invite to add restrictions
                            var sample = System.Text.Json.Nodes.JsonNode.Parse(m.GetResultTableTranslatedJson(3).Item1);
                            if (sample is System.Text.Json.Nodes.JsonObject sampleObj) { sampleObj.Remove("note"); sampleObj.Remove("row_count"); sampleObj.Remove("rows_shown"); }
                            test.Append(", first rows: " + sample?.ToJsonString());
                        }
                    }
                    if (noRow)
                        test.Append("\r\nTEST WARNING: the query returns no row. Check the filter values (spelling, case) with database_execute_query; if no row is really the expected answer, tell the user.");
                    var warnings = (testReport.ExecutionMessages ?? "").Split('\n').Select(l => l.Trim()).Where(l => l.Contains("Warning", StringComparison.OrdinalIgnoreCase)).Distinct().ToList();
                    if (warnings.Count > 0) test.Append("\r\nTEST WARNING: " + string.Join(" ", warnings));
                }
            }
        }
        catch (Exception ex) { test.Append($"TEST FAILED: {ex.Message}"); }
        tool.ExecResult += "\r\n" + test.ToString() +
            "\r\nReport these test results to the user (row count; an error or a warning to fix first) and compare the row count with any figure already given in the conversation: explain a difference before concluding.";
    }
    catch (Exception ex) { tool.ExecResult = $"Error: {ex.Message}"; }
    tool.CurrentToolCall.LogMessage($"Tool '{tool.CurrentToolCall.Name}' finished.");
}
