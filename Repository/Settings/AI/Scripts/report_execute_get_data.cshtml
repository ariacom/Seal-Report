@using System.Text.Json
@using Seal.AI
@{
    AIToolConfiguration tool = Model;
    var args = JsonDocument.Parse(tool.CurrentToolCall.Arguments).RootElement;
    var path = args.GetProperty("path").GetString();
    var modelName = args.TryGetProperty("model_name", out var mnp) ? mnp.GetString() : null;
    var criteria = args.TryGetProperty("criteria", out var cp) && cp.ValueKind != JsonValueKind.Null ? (cp.ValueKind == JsonValueKind.String ? cp.GetString() : cp.GetRawText()) : null;
    tool.CurrentToolCall.LogMessage($"Starting tool '{tool.CurrentToolCall.Name}' (path: {path})..");

    // Right Execute on the folder, values of the prompted criteria, execution, then criteria applied and data of the models (100 rows at most)
    tool.ExecResult = new AIReportWriter(tool).ExecuteSaved(path, modelName, criteria);
    tool.CurrentToolCall.LogMessage($"Tool '{tool.CurrentToolCall.Name}' finished.");
}
