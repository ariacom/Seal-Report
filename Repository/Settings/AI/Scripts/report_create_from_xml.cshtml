@using System.IO
@using System.Linq
@using System.Text
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Xml.Linq
@using Seal.Model
@using Seal.AI
@{
    AIToolConfiguration tool = Model;
    var repo            = Repository.Instance;
    var securityContext = tool.CurrentToolCall.SecurityContext;
    if (securityContext == null) { tool.ExecResult = "Error: no security context available."; return; }

    var args      = JsonDocument.Parse(tool.CurrentToolCall.Arguments).RootElement;
    var path      = Seal.Helpers.FileHelper.ConvertOSFilePath(args.GetProperty("path").GetString());
    tool.CurrentToolCall.LogMessage($"Starting tool '{tool.CurrentToolCall.Name}' (path: {path})..");
    var xml       = args.GetProperty("xml").GetString();
    var overwrite = args.TryGetProperty("overwrite", out var op) && op.GetBoolean();
    var noRecordLimit = args.TryGetProperty("no_record_limit", out var nlp) && nlp.ValueKind == JsonValueKind.True;
    // Reports created by the AI agent are limited by default: a model without a positive <MaxNumberOfRecords> gets this value
    const int defaultMaxNumberOfRecords = 5000;

    var roots = new System.Collections.Generic.Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["Reports"]  = repo.ReportsFolder,
        ["Personal"] = repo.GetPersonalFolder(securityContext),
    };

    // A folder is not a report path: 'Personal\' would resolve outside the user's folders and end in a misleading 'write access denied'
    if (string.IsNullOrWhiteSpace(path) || path.EndsWith(Path.DirectorySeparatorChar) || roots.ContainsKey(path))
        { tool.ExecResult = $"Error: 'path' must end with a report file name, for instance '{path.TrimEnd(Path.DirectorySeparatorChar)}{Path.DirectorySeparatorChar}my_report.srex' (got the folder '{path}'). You have not been denied access: call the tool again with a file name."; return; }

    string fullPath = null;
    foreach (var kv in roots)
        if (path.StartsWith(kv.Key + Path.DirectorySeparatorChar, StringComparison.OrdinalIgnoreCase))
            { fullPath = Path.Combine(kv.Value, path.Substring(kv.Key.Length + 1)); break; }
    if (fullPath == null) fullPath = Path.Combine(repo.ReportsFolder, path);
    if (!fullPath.EndsWith("." + Repository.SealReportFileExtension, StringComparison.OrdinalIgnoreCase))
        fullPath += "." + Repository.SealReportFileExtension;

    if (File.Exists(fullPath) && !overwrite)
        { tool.ExecResult = $"Error: '{path}' already exists. Set overwrite=true to replace it."; return; }


    if (!securityContext.HasFolderRight(Path.GetDirectoryName(fullPath), (int)FolderRight.Edit))
        { tool.ExecResult = $"Error: write access denied to '{path}'."; return; }

    try
    {
        var doc = XDocument.Parse(xml);

        // --- Validate / resolve metadata column references (guard against fabricated GUIDs) ---
        Func<string, string> norm = s => (s ?? "").Replace("[", "").Replace("]", "").Trim().ToLowerInvariant();
        Func<string, string> stripCast = s => { var i = s.IndexOf("::"); return i < 0 ? s : s.Substring(0, i).Trim(); };

        var msGuid = doc.Descendants("MetaSourceGUID")
                        .Select(e => e.Value == null ? null : e.Value.Trim())
                        .FirstOrDefault(v => !string.IsNullOrEmpty(v));
        var metaSource = repo.Sources.FirstOrDefault(s => string.Equals(s.GUID, msGuid, StringComparison.OrdinalIgnoreCase));
        if (metaSource == null)
        {
            tool.ExecResult = $"Error: MetaSourceGUID '{msGuid}' does not match any data source. Use the GUID from datasource_list.";
            return;
        }

        var validColGuids = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var colGuidByName = new System.Collections.Generic.Dictionary<string, string>();
        var colNameByGuid = new System.Collections.Generic.Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        // Column Name (Table.Column) -> GUID, used to detect an element whose <Name> designates another column than its <MetaColumnGUID>
        var colGuidByColName = new System.Collections.Generic.Dictionary<string, string>();
        var ambiguousColNames = new System.Collections.Generic.HashSet<string>();
        foreach (var table in metaSource.MetaData.Tables)
            foreach (var col in table.Columns)
            {
                validColGuids.Add(col.GUID);
                colGuidByName[norm(col.Name)] = col.GUID;
                if (!string.IsNullOrEmpty(col.DisplayName)) colGuidByName[norm(col.DisplayName)] = col.GUID;
                colNameByGuid[col.GUID] = col.Name;
                var colKey = stripCast(norm(col.Name));
                if (colGuidByColName.ContainsKey(colKey)) ambiguousColNames.Add(colKey);
                else colGuidByColName[colKey] = col.GUID;
            }

        var badRefs = new System.Collections.Generic.List<string>();
        var mismatchedRefs = new System.Collections.Generic.List<string>();
        foreach (var mc in doc.Descendants("MetaColumnGUID").ToList())
        {
            var val = mc.Value == null ? "" : mc.Value.Trim();
            var refName = mc.Parent == null ? null : (string)mc.Parent.Element("Name");
            if (!validColGuids.Contains(val))
            {
                string realGuid;
                if (refName != null && colGuidByName.TryGetValue(norm(refName), out realGuid))
                {
                    tool.CurrentToolCall.LogMessage($"Resolved MetaColumnGUID for '{refName.Trim()}': '{val}' -> '{realGuid}'");
                    mc.Value = realGuid;
                    val = realGuid;
                }
                else
                {
                    badRefs.Add(refName != null ? $"'{refName.Trim()}' (supplied GUID '{val}')" : $"GUID '{val}'");
                    continue;
                }
            }
            else if (!metaSource.IsNoSQL && !string.IsNullOrWhiteSpace(refName))
            {
                // A valid GUID copied from another column: the element shows the wrong column under the expected title.
                // Names are compared without their SQL cast suffix (e.g. 'fr.v_table.name::citext').
                var nameKey = stripCast(norm(refName));
                var guidColKey = stripCast(norm(colNameByGuid[val]));
                if (nameKey != guidColKey)
                {
                    string namedGuid;
                    if (!ambiguousColNames.Contains(nameKey) && colGuidByColName.TryGetValue(nameKey, out namedGuid))
                        mismatchedRefs.Add($"'{refName.Trim()}' has the MetaColumnGUID '{val}' of column '{colNameByGuid[val]}' (the GUID of '{refName.Trim()}' is '{namedGuid}')");
                    else if (nameKey.Contains('.') && guidColKey.Contains('.') && nameKey.Substring(0, nameKey.LastIndexOf('.')) == guidColKey.Substring(0, guidColKey.LastIndexOf('.')))
                        mismatchedRefs.Add($"'{refName.Trim()}' is not a column of the source, its MetaColumnGUID '{val}' is the one of column '{colNameByGuid[val]}' (check in which table the column really is)");
                }
            }

            // NoSQL sources resolve each element/restriction in memory by matching its <Name>
            // to a result-table column, whose name is the metadata column's raw field name
            // (e.g. 'year', 'transactions.amount'). A table-qualified name like 'transactions.year'
            // matches nothing and the report fails. Force <Name> to the raw field name.
            if (metaSource.IsNoSQL && mc.Parent != null && colNameByGuid.TryGetValue(val, out var rawName))
            {
                var nameEl = mc.Parent.Element("Name");
                if (nameEl == null) mc.Parent.AddFirst(new XElement("Name", rawName));
                else if (nameEl.Value != rawName)
                {
                    tool.CurrentToolCall.LogMessage($"NoSQL: corrected element Name '{nameEl.Value}' -> '{rawName}'");
                    nameEl.Value = rawName;
                }
            }
        }
        if (badRefs.Count > 0)
        {
            tool.ExecResult = "Error: these MetaColumnGUID values are not columns of source '" + metaSource.Name +
                "': " + string.Join("; ", badRefs) +
                ". Call datasource_get_detail and copy the exact column GUIDs - never invent or sequence GUIDs.";
            return;
        }
        if (mismatchedRefs.Count > 0)
        {
            tool.ExecResult = "Error: the <Name> and the <MetaColumnGUID> designate different columns: " + string.Join("; ", mismatchedRefs) +
                ". Each element and restriction must use the GUID of its own column from datasource_get_detail. Fix the XML and call report_create_from_xml again.";
            return;
        }

        // --- Validate join overrides: a JoinGUID that is not a join of the source is silently ignored by the engine ---
        var badJoins = doc.Descendants("JoinOverride")
            .Select(jo => jo.Element("JoinGUID") == null ? "" : jo.Element("JoinGUID").Value.Trim())
            .Where(g => !metaSource.MetaData.Joins.Any(j => string.Equals(j.GUID, g, StringComparison.OrdinalIgnoreCase)))
            .ToList();
        if (badJoins.Count > 0)
        {
            tool.ExecResult = "Error: these JoinGUID values are not joins of source '" + metaSource.Name + "': " + string.Join("; ", badJoins.Select(g => "'" + g + "'")) +
                ". Call datasource_get_detail and copy the exact join GUID listed under '## Joins'.";
            return;
        }

        // --- Validate restrictions (guard against definitions the engine silently ignores) ---
        // An enumerated restriction is applied only when its operator is Equal/NotEqual and
        // <EnumValues> is filled: a <Value1> or a text operator (Contains, StartsWith...) makes
        // the engine treat it as "not filled" and skip it, so the report runs UNFILTERED with
        // no error. Reject such definitions so the caller can fix the XML.
        var colByGuid = new System.Collections.Generic.Dictionary<string, MetaColumn>(StringComparer.OrdinalIgnoreCase);
        foreach (var table in metaSource.MetaData.Tables)
            foreach (var col in table.Columns)
                colByGuid[col.GUID] = col;

        var restrictionErrors   = new System.Collections.Generic.List<string>();
        var restrictionWarnings = new System.Collections.Generic.List<string>();
        var valueLessOperators  = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { "IsNull", "IsNotNull", "IsEmpty", "IsNotEmpty" };

        // Enumerated lists defined in the report itself (<ReportSource><MetaData><Enums><MetaEnum>), referenced by
        // <EnumGUIDRE> (restriction) or <EnumGUIDEL> (element). A column enum of the data source is inherited without reference.
        var reportEnums = doc.Descendants("ReportSource").Elements("MetaData").Elements("Enums").Elements("MetaEnum").ToList();
        var reportEnumGuids = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var re in reportEnums)
        {
            var reGuid = re.Element("GUID") == null ? "" : re.Element("GUID").Value.Trim();
            var reName = re.Element("Name") == null ? "" : re.Element("Name").Value.Trim();
            var reSql  = re.Element("Sql") == null ? "" : re.Element("Sql").Value.Trim();
            var reDynamic = re.Element("IsDynamic") != null && re.Element("IsDynamic").Value.Trim().ToLowerInvariant() == "true";
            var reHasValues = re.Element("Values") != null && re.Element("Values").Elements("MetaEV").Any();
            if (string.IsNullOrEmpty(reGuid) || string.IsNullOrEmpty(reName))
                { restrictionErrors.Add("a report enumerated list <MetaEnum> must have a <GUID> and a <Name>"); continue; }
            reportEnumGuids.Add(reGuid);
            if (reDynamic && string.IsNullOrEmpty(reSql))
                { restrictionErrors.Add($"enumerated list '{reName}': a dynamic list (<IsDynamic>true</IsDynamic>) needs a <Sql> select statement"); continue; }
            if (!reDynamic && !reHasValues)
                { restrictionErrors.Add($"enumerated list '{reName}': a static list needs <Values><MetaEV><Id>…</Id><Val>…</Val></MetaEV></Values>, or set <IsDynamic>true</IsDynamic> with a <Sql>"); continue; }
            if (reDynamic && !metaSource.IsNoSQL)
            {
                // Check the SQL now: a failing list shows an empty prompt at execution
                var check = MetaEnum.Create();
                check.Name = reName;
                check.IsDynamic = true;
                check.Sql = reSql;
                check.Source = metaSource;
                check.RefreshEnum();
                if (!string.IsNullOrEmpty(check.Error))
                    restrictionErrors.Add($"enumerated list '{reName}': the <Sql> failed: {check.Error}");
                else
                    tool.CurrentToolCall.LogMessage($"Enumerated list '{reName}': {check.Values.Count} value(s) loaded");
            }
        }

        foreach (var el in doc.Descendants("ReportElement").Where(e => e.Element("EnumGUIDEL") != null && !string.IsNullOrWhiteSpace(e.Element("EnumGUIDEL").Value)))
        {
            var g = el.Element("EnumGUIDEL").Value.Trim();
            if (!reportEnumGuids.Contains(g) && !metaSource.MetaData.Enums.Any(e => string.Equals(e.GUID, g, StringComparison.OrdinalIgnoreCase)))
                restrictionErrors.Add($"element '{(string)el.Element("Name")}': <EnumGUIDEL> '{g}' matches no enumerated list of the report or of the data source");
        }

        foreach (var rest in doc.Descendants("ReportRestriction"))
        {
            var colGuid = rest.Element("MetaColumnGUID") == null ? null : rest.Element("MetaColumnGUID").Value.Trim();
            MetaColumn rcol = null;
            if (colGuid == null || !colByGuid.TryGetValue(colGuid, out rcol)) continue;

            var restName = rest.Element("Name") != null && !string.IsNullOrEmpty(rest.Element("Name").Value) ? rest.Element("Name").Value.Trim() : rcol.Name;
            var restOp   = rest.Element("Operator") != null ? rest.Element("Operator").Value.Trim() : "Equal";
            var enumEls  = rest.Element("EnumValues") == null ? new System.Collections.Generic.List<XElement>() : rest.Element("EnumValues").Elements("string").ToList();
            var hasVal1  = rest.Element("Value1") != null && !string.IsNullOrEmpty(rest.Element("Value1").Value);
            var prompted = rest.Element("Prompt") != null && rest.Element("Prompt").Value.Trim() != "None";

            // Enumerated list of the restriction: the report list referenced by <EnumGUIDRE> wins over the column list of the data source
            MetaEnum menum = null;
            var isEnum = false;
            var enumRef = rest.Element("EnumGUIDRE") == null ? "" : rest.Element("EnumGUIDRE").Value.Trim();
            if (!string.IsNullOrEmpty(enumRef))
            {
                if (reportEnumGuids.Contains(enumRef)) isEnum = true;
                else
                {
                    menum = metaSource.MetaData.Enums.FirstOrDefault(e => string.Equals(e.GUID, enumRef, StringComparison.OrdinalIgnoreCase));
                    if (menum == null)
                    {
                        restrictionErrors.Add($"'{restName}': <EnumGUIDRE> '{enumRef}' matches no enumerated list: define it under <ReportSource><MetaData><Enums>");
                        continue;
                    }
                    isEnum = true;
                }
            }
            else if (!string.IsNullOrEmpty(rcol.EnumGUID))
            {
                menum = metaSource.MetaData.Enums.FirstOrDefault(e => e.GUID == rcol.EnumGUID);
                isEnum = menum != null;
            }

            if (!isEnum)
            {
                // <EnumValues> on a column without enumerated list are ignored: the prompt is a text box and the filter is never applied
                if (enumEls.Count > 0)
                    restrictionErrors.Add($"'{restName}': the column has no enumerated list, so <EnumValues> is ignored (the prompt stays a text box and the filter is not applied). For a drop-down list, define an enumerated list in the report (<ReportSource><MetaData><Enums>) and reference it with <EnumGUIDRE>; otherwise use <Value1>");
                continue;
            }

            if (valueLessOperators.Contains(restOp)) continue;

            if (restOp != "Equal" && restOp != "NotEqual")
            {
                restrictionErrors.Add($"'{restName}': operator '{restOp}' is invalid on an enumerated column (only Equal or NotEqual are supported)");
                continue;
            }
            if (hasVal1 && enumEls.Count == 0)
            {
                restrictionErrors.Add($"'{restName}': <Value1> is ignored on an enumerated column, list the values as <EnumValues><string>value</string></EnumValues>");
                continue;
            }
            if (enumEls.Count == 0 && !prompted)
            {
                restrictionErrors.Add($"'{restName}': static (not prompted) restriction has no <EnumValues>, it would be skipped at execution");
                continue;
            }

            // EnumValues must contain the enum value ids: map display labels back to their id,
            // and warn about values unknown to the enumerated list (dynamic lists may be stale,
            // so an unknown value is not a hard error).
            if (enumEls.Count > 0 && menum != null && menum.Values.Count > 0)
            {
                foreach (var vEl in enumEls)
                {
                    var v = vEl.Value;
                    if (menum.Values.Any(ev => ev.Id == v)) continue;
                    var byLabel = menum.Values.FirstOrDefault(ev => (!string.IsNullOrEmpty(ev.Val) && ev.Val == v) || ev.DisplayValue == v);
                    if (byLabel != null)
                    {
                        tool.CurrentToolCall.LogMessage($"Restriction '{restName}': mapped enum label '{v}' -> id '{byLabel.Id}'");
                        vEl.Value = byLabel.Id;
                    }
                    else restrictionWarnings.Add($"'{restName}': value '{v}' is not in the enumerated list '{menum.Name}' (the filter may match nothing)");
                }
            }
        }

        // A restriction defined in <Restrictions>/<AggregateRestrictions> but not referenced in
        // the model's <Restriction>/<AggregateRestriction> expression is silently inactive.
        foreach (var model in doc.Descendants("ReportModel"))
        {
            foreach (var pair in new[] { new[] { "Restriction", "Restrictions" }, new[] { "AggregateRestriction", "AggregateRestrictions" } })
            {
                var exprText = model.Element(pair[0]) == null ? "" : model.Element(pair[0]).Value;
                var defs     = model.Element(pair[1]) == null ? new System.Collections.Generic.List<XElement>() : model.Element(pair[1]).Elements("ReportRestriction").ToList();
                foreach (var rest in defs)
                {
                    var g = rest.Element("GUID") == null ? null : rest.Element("GUID").Value.Trim();
                    if (string.IsNullOrEmpty(g) || exprText.Contains("[" + g + "]")) continue;
                    var n = rest.Element("Name") != null ? rest.Element("Name").Value.Trim() : g;
                    restrictionErrors.Add($"'{n}': defined in <{pair[1]}> but not referenced in the <{pair[0]}> expression, it would be inactive - add [{g}] to the expression or remove the restriction");
                }
            }
        }

        if (restrictionErrors.Count > 0)
        {
            tool.ExecResult = "Error: invalid restriction definition(s): " + string.Join("; ", restrictionErrors) +
                ". Enumerated columns accept only Equal/NotEqual with <EnumValues><string>value</string></EnumValues>" +
                " (a <Value1> or another operator is silently ignored at execution). Fix the XML and call report_create_from_xml again.";
            return;
        }

        // A Map view needs a latitude and a longitude column: set by the map_latitude/map_longitude parameters,
        // or found from the element names. Otherwise the view fails at execution.
        var mapErrors = new System.Collections.Generic.List<string>();
        foreach (var mapView in doc.Descendants("ReportView").Where(v => (string)v.Element("TemplateName") == "Map"))
        {
            Func<string, string> mapParam = n => mapView.Element("Parameters") == null ? null : mapView.Element("Parameters").Elements("Parameter")
                .Where(p => (string)p.Element("Name") == n).Select(p => (string)p.Element("Value")).FirstOrDefault();
            var elementNames = doc.Descendants("ReportElement").SelectMany(e => new[] {
                (string)e.Element("DisplayName"), (string)e.Element("Name"),
                e.Element("MetaColumnGUID") != null && colByGuid.ContainsKey(e.Element("MetaColumnGUID").Value.Trim()) ? colByGuid[e.Element("MetaColumnGUID").Value.Trim()].DisplayName : null })
                .Where(n => !string.IsNullOrEmpty(n)).ToList();
            foreach (var coord in new[] { "latitude", "longitude" })
            {
                if (!string.IsNullOrEmpty(mapParam("map_" + coord))) continue;
                if (!elementNames.Any(n => n.ToLowerInvariant().Contains(coord)))
                    mapErrors.Add($"the Map view needs a {coord} column: add it as a Row element (its name must contain '{coord}', or set the 'map_{coord}' parameter to its display name). If the source has no coordinates, do not add a Map view and tell the user that a map is not possible");
            }
        }
        if (mapErrors.Count > 0)
        {
            tool.ExecResult = "Error: " + string.Join("; ", mapErrors.Distinct()) + ".";
            return;
        }

        // Default record limit of the reports created by the AI agent: a model without a positive limit gets
        // the default, unless the user explicitly asked for no limit (no_record_limit=true).
        var limitedModels = 0;
        if (!noRecordLimit)
        {
            foreach (var model in doc.Descendants("ReportModel"))
            {
                var maxEl = model.Element("MaxNumberOfRecords");
                int maxVal;
                if (maxEl != null && int.TryParse(maxEl.Value.Trim(), out maxVal) && maxVal > 0) continue;
                if (maxEl != null) maxEl.Value = defaultMaxNumberOfRecords.ToString();
                else
                {
                    var anchor = model.Element("Alias") ?? model.Element("SourceGUID") ?? model.Element("Name") ?? model.Element("GUID");
                    if (anchor != null) anchor.AddAfterSelf(new XElement("MaxNumberOfRecords", defaultMaxNumberOfRecords));
                    else model.AddFirst(new XElement("MaxNumberOfRecords", defaultMaxNumberOfRecords));
                }
                limitedModels++;
            }
        }

        // Only regenerate internal cross-reference GUIDs.
        // MetaSourceGUID and MetaColumnGUID must be preserved — they reference
        // actual repository metadata objects and must be supplied correctly by the caller.
        var internalNames = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "GUID", "ViewGUID", "SourceGUID", "ModelGUID"
        };

        // Build old→new map from all internal GUID elements
        var guidMap = new System.Collections.Generic.Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var el in doc.Descendants())
        {
            if (!internalNames.Contains(el.Name.LocalName)) continue;
            var val = el.Value?.Trim();
            if (!string.IsNullOrEmpty(val) && !guidMap.ContainsKey(val))
                guidMap[val] = Guid.NewGuid().ToString();
        }

        // Rewrite internal GUID elements with the new values
        foreach (var el in doc.Descendants())
        {
            if (!internalNames.Contains(el.Name.LocalName)) continue;
            var val = el.Value?.Trim();
            if (!string.IsNullOrEmpty(val) && guidMap.TryGetValue(val, out var rep))
                el.Value = rep;
        }

        // References to an enumerated list defined in the report follow its regenerated GUID
        // (a reference to a data source list is not in the map and is kept as is).
        foreach (var el in doc.Descendants().Where(e => e.Name.LocalName == "EnumGUIDRE" || e.Name.LocalName == "EnumGUIDEL").ToList())
        {
            var val = el.Value?.Trim();
            if (!string.IsNullOrEmpty(val) && guidMap.TryGetValue(val, out var rep)) el.Value = rep;
        }

        // Rewrite GUID references inside <Restriction> and <AggregateRestriction> text.
        // The format is [key] where key may be a real GUID or any short placeholder (e.g. f1).
        // Match anything inside brackets and remap it if found in guidMap.
        var restrictionNames = new System.Collections.Generic.HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "Restriction", "AggregateRestriction"
        };
        foreach (var el in doc.Descendants())
        {
            if (!restrictionNames.Contains(el.Name.LocalName) || string.IsNullOrEmpty(el.Value)) continue;
            el.Value = Regex.Replace(el.Value,
                @"\[([^\]]+)\]",
                m => {
                    var inner = m.Groups[1].Value;
                    return guidMap.TryGetValue(inner, out var rep) ? "[" + rep + "]" : m.Value;
                });
        }

        var sb = new StringBuilder();
        if (doc.Declaration != null) { sb.Append(doc.Declaration).Append("\r\n"); }
        sb.Append(doc.ToString());

        var dir = Path.GetDirectoryName(fullPath);
        if (!Directory.Exists(dir)) Directory.CreateDirectory(dir);
        File.WriteAllText(fullPath, sb.ToString(), System.Text.Encoding.UTF8);

        tool.ExecResult = $"Created: {path}";
        if (limitedModels > 0)
            tool.ExecResult += $"\r\nNote: the result is limited to {defaultMaxNumberOfRecords} records (default limit of the reports created by the AI agent, <MaxNumberOfRecords>). Mention it to the user.";
        if (restrictionWarnings.Count > 0)
            tool.ExecResult += "\r\nWarning: " + string.Join("; ", restrictionWarnings) +
                ". Verify the values with database_get_sample_values and recreate the report with overwrite=true if they are wrong.";
    }
    catch (Exception ex) { tool.ExecResult = $"Error: {ex.Message}"; }
    tool.CurrentToolCall.LogMessage($"Tool '{tool.CurrentToolCall.Name}' finished.");
}
