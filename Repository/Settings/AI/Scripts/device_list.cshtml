@using System.Text
@using System.Linq
@using Seal.Model
@using Seal.AI
@{
    AIToolConfiguration tool = Model;
    tool.CurrentToolCall.LogMessage($"Starting tool '{tool.CurrentToolCall.Name}'..");
    var sb = new System.Text.StringBuilder();

    var devices = tool.GetAvailableDevices().ToList();
    if (devices.Count == 0)
    {
        tool.ExecResult = "No output device is available for the current user.";
        tool.CurrentToolCall.LogMessage($"Tool '{tool.CurrentToolCall.Name}' finished.");
        return;
    }

    sb.AppendLine("Output devices available for the current user. Pass device_name to report_configure_output to select one (device_type must match the listed type).");
    sb.AppendLine();

    //Name and type only: the servers of the devices (SMTP relay, FTP host, SharePoint site) are details of the infrastructure,
    //not needed to configure an output and not to be shown to the users
    foreach (var device in devices)
    {
        string type = device is OutputEmailDevice ? "email" : device is OutputFileServerDevice ? "ftp" : device is OutputSharePointDevice ? "sharepoint" : device is OutputFolderDevice ? "folder" : device.GetType().Name;
        sb.AppendLine($"## {device.Name} [type: {type}] (GUID: {device.GUID})");
    }

    tool.ExecResult = sb.ToString();
    tool.CurrentToolCall.LogMessage($"Tool '{tool.CurrentToolCall.Name}' finished.");
}
