@using System
@using System.Linq
@using System.Collections.Generic
@using System.Text
@using System.Text.Json
@using Seal.Model
@using Seal.AI
@{
    AIToolConfiguration tool = Model;
    var args   = JsonDocument.Parse(tool.CurrentToolCall.Arguments).RootElement;
    var name   = args.GetProperty("name").GetString();
    // Optional filter: table names or name prefixes (e.g. "dg." or "ref.v_commune"); the other tables are only listed by name
    var filters = args.TryGetProperty("tables", out var tp) && tp.ValueKind == JsonValueKind.Array
        ? tp.EnumerateArray().Select(i => i.GetString()?.Trim()).Where(i => !string.IsNullOrEmpty(i)).ToList()
        : new List<string>();
    tool.CurrentToolCall.LogMessage($"Starting tool '{tool.CurrentToolCall.Name}' (name: {name}{(filters.Count > 0 ? ", tables: " + string.Join(", ", filters) : "")})..");
    var source = tool.GetAvailableSources().FirstOrDefault(i => i.Name == name);
    if (source == null) { tool.ExecResult = $"Error: data source '{name}' not found or not allowed."; return; }
    bool Matches(MetaTable t, string f) => (t.Name ?? "").StartsWith(f, StringComparison.OrdinalIgnoreCase) || (t.AliasName ?? "").StartsWith(f, StringComparison.OrdinalIgnoreCase);
    var tables = source.MetaData.Tables.Where(t => filters.Count == 0 || filters.Any(f => Matches(t, f))).ToList();
    var notFound = filters.Where(f => !source.MetaData.Tables.Any(t => Matches(t, f))).ToList();
    if (tables.Count == 0) { tool.ExecResult = $"Error: no table of '{name}' matches {string.Join(", ", filters)}. Tables: {string.Join(", ", source.MetaData.Tables.Select(t => t.AliasName))}."; return; }

    var sb = new StringBuilder();

    // --- Connection (no credentials) ---
    sb.AppendLine($"# {source.Name}{(string.IsNullOrEmpty(source.Description) ? "" : $" — {source.Description}")}");
    sb.AppendLine($"GUID           : {source.GUID}");
    sb.AppendLine($"Database type  : {source.Connection?.DatabaseType}");
    sb.AppendLine($"Connection type: {source.Connection?.ConnectionType}");
    if (!string.IsNullOrEmpty(source.Connection?.Description)) sb.AppendLine($"Connection     : {source.Connection.Description}");
    sb.AppendLine($"Is default     : {source.IsDefault}");
    sb.AppendLine($"Storage        : {(source.IsNoSQL ? "NoSQL — use report_create_from_xml; SQL tools (database_execute_query, SQL dialects) do not apply" : "SQL")}");
    sb.AppendLine();

    // --- Tables and columns ---
    sb.AppendLine("## Tables");
    if (notFound.Count > 0) sb.AppendLine($"Not found (these tables do not exist, do not use them): {string.Join(", ", notFound)}.\r\n");
    var others = source.MetaData.Tables.Where(t => !tables.Contains(t)).ToList();
    if (others.Count > 0) sb.AppendLine($"Detail limited to {tables.Count} table(s). Other tables (call again with their name in 'tables' for their columns): {string.Join(", ", others.Select(t => t.AliasName))}.\r\n");
    foreach (var table in tables)
    {
        var tableName = string.IsNullOrEmpty(table.Alias) ? table.Name : $"{table.Name} (alias: {table.Alias})";
        sb.AppendLine($"### {tableName}{(string.IsNullOrEmpty(table.Description) ? "" : $" — {table.Description}")}");
        foreach (var col in table.Columns)
        {
            var label = col.DisplayName != col.Name && !string.IsNullOrEmpty(col.DisplayName)
                        ? $"{col.Name} ({col.DisplayName})"
                        : col.Name;
            var enumInfo = col.Enum != null ? $", enumerated list: {col.Enum.Name}{(string.IsNullOrEmpty(col.Enum.Description) ? "" : $" ({col.Enum.Description})")}" : "";
            var colDescription = string.IsNullOrEmpty(col.Description) ? "" : $" — {col.Description}";
            sb.AppendLine($"  {label} [{col.Type}{(col.IsAggregate ? ", aggregate" : "")}{enumInfo}] (GUID: {col.GUID}){colDescription}");
        }
        sb.AppendLine();
    }

    // --- Joins ---
    // joins touching a detailed table
    var joins = source.MetaData.Joins.Where(j => filters.Count == 0 || tables.Contains(j.LeftTable) || tables.Contains(j.RightTable)).ToList();
    if (joins.Count > 0)
    {
        sb.AppendLine("## Joins");
        foreach (var join in joins)
        {
            var left  = join.LeftTable?.AliasName  ?? "?";
            var right = join.RightTable?.AliasName ?? "?";
            var joinInfo = $"{join.JoinType}{(join.IsBiDirectional ? "" : ", not bi-directional")}{(join.Weight != 1 ? $", weight {join.Weight}" : "")}";
            sb.AppendLine($"  {left} → {right} [{joinInfo}] (GUID: {join.GUID}){(string.IsNullOrEmpty(join.Description) ? "" : $" — {join.Description}")}");
            if (!string.IsNullOrWhiteSpace(join.Clause))
                sb.AppendLine($"    ON {join.Clause.Trim()}");
        }
    }

    tool.ExecResult = sb.ToString();
    tool.CurrentToolCall.LogMessage($"Tool '{tool.CurrentToolCall.Name}' finished.");
}
