<?xml version="1.0" encoding="utf-8"?><Report xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"><GUID>4eca0e85-f012-4f81-9242-386a3f5db825</GUID><Guide>&lt;p&gt;Three ways to display a prompted enumerated list:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;strong&gt;Category&lt;/strong&gt; then &lt;strong&gt;Product Name&lt;/strong&gt;: the list of products depends on the categories selected (keyword '{EnumValues_Category}' in the 'SQL Select Statement for prompted restriction').&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Product Name Search&lt;/strong&gt;: type 2 characters to filter the list (keyword '{EnumFilter}'). The list of products is loaded as a whole before the execution.&lt;/li&gt;&lt;li&gt;&lt;strong&gt;Product Name Search (on demand)&lt;/strong&gt;: same search, but the &lt;strong&gt;values are loaded on demand&lt;/strong&gt;: the list is never loaded as a whole, only the values returned for the characters typed and the values selected (keyword '{EnumSelected}' in the 'SQL Select Statement for selected values'). Use it for lists of thousands of customers or companies.&lt;/li&gt;&lt;/ul&gt;</Guide><ViewGUID>f334faeb-bf60-4a03-bc19-318071f26fc0</ViewGUID><Sources><ReportSource><GUID>c22f1e8b-0f64-4891-97e8-e7dbb4dbe09d</GUID><Name>Northwind (Repository)</Name><ConnectionGUID>1</ConnectionGUID><MetaData><Enums><MetaEnum><GUID>4bffee60-0c35-49c4-9258-653062afbbce</GUID><Name>Product Name Search By Char</Name><IsDynamic>true</IsDynamic><IsDbRefresh>true</IsDbRefresh><Sql>SELECT ProductID, ProductName 
FROM Products
ORDER BY ProductName</Sql><FilterChars>2</FilterChars><Message>Please type 2 characters</Message><SqlDisplay>SELECT ProductID, ProductName 
FROM Products
WHERE ProductName LIKE '%{EnumFilter}%'
ORDER BY ProductName</SqlDisplay></MetaEnum><MetaEnum><GUID>9e3f1b7a-2c4d-4e6f-8a1b-3c5d7e9f0a24</GUID><Name>Product Name Search On Demand</Name><IsDynamic>true</IsDynamic><IsDbRefresh>true</IsDbRefresh><FilterChars>2</FilterChars><Message>Please type 2 characters</Message><SqlDisplay>SELECT TOP 100 ProductID, ProductName 
FROM Products
WHERE ProductName LIKE '%{EnumFilter}%'
ORDER BY ProductName</SqlDisplay><LoadOnDemand>true</LoadOnDemand><SqlSelected>SELECT ProductID, ProductName 
FROM Products
WHERE ProductID IN ({EnumSelected})</SqlSelected></MetaEnum></Enums></MetaData><MetaSourceGUID>52833575-11ae-4b7d-8b5e-0f9b29d1267a</MetaSourceGUID></ReportSource></Sources><Models><ReportModel><GUID>ea786c35-cdc9-42a7-9d98-528562dbf822</GUID><Name>Model</Name><SourceGUID>c22f1e8b-0f64-4891-97e8-e7dbb4dbe09d</SourceGUID><Elements><ReportElement><GUID>311a7669-3e0f-4ef5-99c3-e768f56a5ce5</GUID><Name>Products.CategoryID</Name><DisplayName /><Format>N0</Format><PivotPosition>Row</PivotPosition><AggregateFunction>Count</AggregateFunction><MetaColumnGUID>f1ca9f05-b6a3-46da-b753-68cb4056cb66</MetaColumnGUID></ReportElement><ReportElement><GUID>04453295-85c9-4237-9a17-b87953cf75d9</GUID><Name>Products.ProductName</Name><DisplayName /><PivotPosition>Row</PivotPosition><AggregateFunction>Count</AggregateFunction><MetaColumnGUID>087ed2f1-b58b-4407-9291-8329ee5dbfe1</MetaColumnGUID></ReportElement><ReportElement><GUID>e4ac3596-f28f-444a-bf19-3b657d36bbb7</GUID><PivotPosition>Hidden</PivotPosition><SortOrder>Not sorted</SortOrder><MetaColumnGUID>d0a693f9-e276-4e6d-9ac2-d4d031610430</MetaColumnGUID></ReportElement></Elements><Restriction>([cc93b2e3-10d5-40ab-8aa8-ab8129322db7]

