        <Enums>
          <MetaEnum>
            <GUID>d19c1021-441b-4497-b113-0e0f33d0e643</GUID>
            <Name>Sources</Name>
            <IsDynamic>true</IsDynamic>
            <IsDbRefresh>true</IsDbRefresh>
            <Script>@{
    var enumList = Model;
    enumList.Values.Clear();
    //Init the sources enums
    foreach (var source in Repository.Instance.Sources) {
        enumList.Values.Add(new MetaEV() { Id = source.Name, });
    }
}
</Script>
