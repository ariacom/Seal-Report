    <ReportSource>
      <GUID>0e01948d-7f9d-4ffd-9561-7d1ae3550b26</GUID>
      <Name>MCP Tokens</Name>
      <Connections>
        <MetaConnection>
          <GUID>4230ee3a-5d08-40fd-bea7-6c665e286dbb</GUID>
          <Name>connection</Name>
        </MetaConnection>
      </Connections>
      <ConnectionGUID>4230ee3a-5d08-40fd-bea7-6c665e286dbb</ConnectionGUID>
      <IsNoSQL>true</IsNoSQL>
      <MetaData>
        <Tables>
          <MetaTable>
            <GUID>4d77c9e6-3b7a-4079-9807-79201a5d31c4</GUID>
            <Name>Tokens</Name>
            <TemplateName>Default</TemplateName>
            <DefinitionScript>@using System.Data
@{
	MetaTable metaTable = Model;
	metaTable.NoSQLTable = new DataTable();
	metaTable.NoSQLTable.Columns.Add(new DataColumn("user", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("token", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("id", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("status", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("creation", typeof(DateTime)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("expiration", typeof(DateTime)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("last_use", typeof(DateTime)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("information", typeof(string)));

	metaTable.LogMessage("{0} column(s) defined", metaTable.NoSQLTable.Columns.Count);
}
</DefinitionScript>
            <LoadScript>@using System.Data
@using Seal.AI
@{
	MetaTable metaTable = Model;
	DataTable table = metaTable.NoSQLTable;
	ReportExecutionLog log = metaTable;
	var config = Repository.Instance.AIConfiguration;
	var now = DateTime.Now;
	//Tokens of all the users read from the token store: name, dates and status only (the hash of a token is never shown)
	foreach (var t in McpGateway.TokenStore.GetAllTokens())
	{
		var error = t.CheckValidity(now, config.McpTokenIdleDays);
		var status = error == null ? "Active" : (t.Expiration != null &amp;&amp; now &gt;= t.Expiration.Value ? "Expired" : "Inactive");
		if (error == null &amp;&amp; t.Expiration != null &amp;&amp; t.Expiration.Value &lt; now.AddDays(7)) status = "Expires soon";
		table.Rows.Add(t.UserName, t.Name, t.Id, status, t.Creation, t.Expiration.HasValue ? (object)t.Expiration.Value : DBNull.Value, t.LastUse.HasValue ? (object)t.LastUse.Value : DBNull.Value, error ?? "");
	}
	log.LogMessage("{0} record(s) loaded", table.Rows.Count);
}</LoadScript>
