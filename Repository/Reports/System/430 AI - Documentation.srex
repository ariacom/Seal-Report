  <InitScript>@{
    Report report = Model;
	ReportExecutionLog log = report;

    //Fill the list of agents
    var anEnum = report.Sources.First().MetaData.Enums.First();
    anEnum.Values.Clear();
    foreach (var agent in Repository.Instance.AIConfiguration.AIAgents.OrderBy(i =&gt; i.Name)) {
        anEnum.Values.Add(new MetaEV() {Id=agent.Name, Val = agent.Name});
    }
}</InitScript>
  <Cancel>false</Cancel>
</Report>