            <DefinitionScript>@using System.Data
@{
	MetaTable metaTable = Model;
	metaTable.NoSQLTable = new DataTable();
	metaTable.NoSQLTable.Columns.Add(new DataColumn("agent", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("kind", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("name", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("via_skill", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("enabled", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("description", typeof(string)));

	metaTable.LogMessage("{0} column(s) defined", metaTable.NoSQLTable.Columns.Count);
}
</DefinitionScript>
            <LoadScript>@using System.Data
@using Seal.AI
@{
	MetaTable metaTable = Model;
	DataTable table = metaTable.NoSQLTable;
	ReportExecutionLog log = metaTable;
	var config = Repository.Instance.AIConfiguration;
	Func&lt;string, string&gt; toolName = (guid) =&gt; config.AITools.FirstOrDefault(i =&gt; i.GUID == guid)?.Name ?? guid;
	Func&lt;string, string&gt; skillName = (guid) =&gt; config.AISkills.FirstOrDefault(i =&gt; i.GUID == guid)?.Name ?? guid;
	Func&lt;bool, string&gt; yesNo = (value) =&gt; value ? "Yes" : "No";
	foreach (var a in config.AIAgents)
	{
		foreach (var guid in a.ToolGUIDs)
		{
			var tool = config.AITools.FirstOrDefault(i =&gt; i.GUID == guid);
			table.Rows.Add(a.Name, "Tool", toolName(guid), "", yesNo(tool != null &amp;&amp; tool.IsEnabled), tool?.Description ?? "Unknown tool");
		}
		foreach (var guid in a.SkillGUIDs)
		{
			var skill = config.AISkills.FirstOrDefault(i =&gt; i.GUID == guid);
			table.Rows.Add(a.Name, "Skill", skillName(guid), "", yesNo(skill != null &amp;&amp; skill.IsEnabled), skill?.Description ?? "Unknown skill");
			if (skill == null) continue;
			foreach (var toolGuid in skill.ToolGUIDs)
			{
				var tool = config.AITools.FirstOrDefault(i =&gt; i.GUID == toolGuid);
				table.Rows.Add(a.Name, "Tool (skill)", toolName(toolGuid), skill.Name, yesNo(tool != null &amp;&amp; tool.IsEnabled), tool?.Description ?? "Unknown tool");
			}
		}
	}
	log.LogMessage("{0} record(s) loaded", table.Rows.Count);
}</LoadScript>
