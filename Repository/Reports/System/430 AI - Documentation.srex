            <LoadScript>@using System.Data
@using Seal.AI
@{
	MetaTable metaTable = Model;
	DataTable table = metaTable.NoSQLTable;
	ReportExecutionLog log = metaTable;
	var config = Repository.Instance.AIConfiguration;
	Func&lt;string, string&gt; toolName = (guid) =&gt; config.AITools.FirstOrDefault(i =&gt; i.GUID == guid)?.Name ?? guid;
	Func&lt;string, string&gt; skillName = (guid) =&gt; config.AISkills.FirstOrDefault(i =&gt; i.GUID == guid)?.Name ?? guid;
	Func&lt;bool, string&gt; yesNo = (value) =&gt; value ? "Yes" : "No";
	foreach (var t in config.AITools)
	{
		var parameters = new List&lt;string[]&gt;();
		Newtonsoft.Json.Linq.JObject schema = null;
		try { if (!string.IsNullOrWhiteSpace(t.ParametersSchema)) schema = Newtonsoft.Json.Linq.JObject.Parse(t.ParametersSchema); } catch { }
		var required = new List&lt;string&gt;();
		if (schema != null &amp;&amp; schema["required"] is Newtonsoft.Json.Linq.JArray requiredArray) foreach (var r in requiredArray) required.Add(r.ToString());
		var properties = schema?["properties"] as Newtonsoft.Json.Linq.JObject;
		if (properties != null)
		{
			foreach (var property in properties.Properties())
			{
				var typeToken = property.Value["type"];
				string type = typeToken is Newtonsoft.Json.Linq.JArray typeArray ? string.Join("|", typeArray) : (typeToken?.ToString() ?? "");
				if (type == "array") type = "array of " + (property.Value["items"]?["type"]?.ToString() ?? "object");
				var enumToken = property.Value["enum"] as Newtonsoft.Json.Linq.JArray;
				if (enumToken != null) type += " (" + string.Join(", ", enumToken) + ")";
				parameters.Add(new string[] { property.Name, type, yesNo(required.Contains(property.Name)), property.Value["description"]?.ToString() ?? "" });
			}
		}
		parameters = parameters.OrderBy(i =&gt; i[2] == "Yes" ? 0 : 1).ToList();
		var skills = config.AISkills.Where(i =&gt; i.ToolGUIDs.Contains(t.GUID)).Select(i =&gt; i.Name);
		var agents = config.AIAgents.Where(i =&gt; i.ToolGUIDs.Contains(t.GUID)).Select(i =&gt; i.Name);
		table.Rows.Add(t.Name, t.Description ?? "", yesNo(t.IsEnabled), t.ProgressLabel ?? "", t.ExecutionScriptFile ?? "",
			string.Join(", ", parameters.Select(i =&gt; i[0] + (i[2] == "Yes" ? "*" : ""))), string.Join(", ", skills), string.Join(", ", agents));
	}
	log.LogMessage("{0} record(s) loaded", table.Rows.Count);
}</LoadScript>
