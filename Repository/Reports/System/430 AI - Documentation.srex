            <DefinitionScript>@using System.Data
@{
	MetaTable metaTable = Model;
	metaTable.NoSQLTable = new DataTable();
	metaTable.NoSQLTable.Columns.Add(new DataColumn("agent", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("description", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("enabled", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("is_default", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("provider", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("max_report_code_level", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("max_tool_calls", typeof(double)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("temperature", typeof(double)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("max_tokens", typeof(double)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("top_p", typeof(double)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("system_prompt", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("sample_prompts", typeof(string)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("tools", typeof(double)));
	metaTable.NoSQLTable.Columns.Add(new DataColumn("skills", typeof(double)));

	metaTable.LogMessage("{0} column(s) defined", metaTable.NoSQLTable.Columns.Count);
}
</DefinitionScript>
            <LoadScript>@using System.Data
@using Seal.AI
@{
	MetaTable metaTable = Model;
	DataTable table = metaTable.NoSQLTable;
	ReportExecutionLog log = metaTable;
	var config = Repository.Instance.AIConfiguration;
	Func&lt;string, string&gt; toolName = (guid) =&gt; config.AITools.FirstOrDefault(i =&gt; i.GUID == guid)?.Name ?? guid;
	Func&lt;string, string&gt; skillName = (guid) =&gt; config.AISkills.FirstOrDefault(i =&gt; i.GUID == guid)?.Name ?? guid;
	Func&lt;bool, string&gt; yesNo = (value) =&gt; value ? "Yes" : "No";
	foreach (var a in config.AIAgents)
	{
		var provider = a.GetProviderConfiguration();
		string providerName = provider != null ? provider.Name : "";
		if (a.ProviderGUID == AIProviderConfiguration.DefaultProviderGUID) providerName = "Default provider" + (provider != null ? " (" + provider.Name + ")" : "");

		var prompt = new List&lt;string&gt;();
		if (!string.IsNullOrEmpty(a.SystemPromptFile)) prompt.Add("File: " + a.SystemPromptFile);
		if (!string.IsNullOrEmpty(a.SystemPromptScriptFile)) prompt.Add("Script: " + a.SystemPromptScriptFile);
		if (!string.IsNullOrWhiteSpace(a.DefaultSystemPrompt)) prompt.Add(a.DefaultSystemPrompt.Length &gt; 200 ? a.DefaultSystemPrompt.Substring(0, 200) + "..." : a.DefaultSystemPrompt);
		var samples = new List&lt;string&gt;();
		if (!string.IsNullOrEmpty(a.SamplePromptsFile)) samples.Add("File: " + a.SamplePromptsFile);
		if (!string.IsNullOrEmpty(a.SamplePromptsScriptFile)) samples.Add("Script: " + a.SamplePromptsScriptFile);

		table.Rows.Add(a.Name, a.Description ?? "", yesNo(a.IsEnabled), yesNo(a.GUID == config.DefaultAgentGUID), providerName, a.MaxReportCodeLevel.ToString(), a.MaxToolCalls, a.Temperature, a.MaxTokens, a.TopP,
			string.Join("\r\n", prompt), string.Join("\r\n", samples), a.ToolGUIDs.Count, a.SkillGUIDs.Count);
	}
	log.LogMessage("{0} record(s) loaded", table.Rows.Count);
}</LoadScript>
