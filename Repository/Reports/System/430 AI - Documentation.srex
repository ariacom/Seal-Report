  <Tasks>
    <ReportTask>
      <GUID>42fb4105-dca6-413f-a83b-72987f198814</GUID>
      <Name>Default</Name>
      <Tasks />
      <ExecProcessChildren>true</ExecProcessChildren>
      <TemplateName>Default</TemplateName>
      <SourceGUID>033cdcf1-75a4-4099-b379-4523120cb940</SourceGUID>
      <Script>@using System.Data
@using System.Data.Common
@{
    ReportTask task = Model;
    Report report = task.Report;
    //Apply the agents selected in the input value to the restrictions of the models
    var inputValue = report.InputValues[0];
    foreach (var model in report.Models) {
        foreach (var restriction in model.Restrictions) {
            restriction.EnumValues = inputValue.EnumValues;
        }
    }
}</Script>
      <SortOrder>1</SortOrder>
    </ReportTask>
  </Tasks>
