    <ReportModel>
      <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0200</GUID>
      <Name>Never executed</Name>
      <SourceGUID>9a05a916-9500-4113-8dc5-100679b0f4db</SourceGUID>
      <CommonRestrictions>
        <ReportRestriction>
          <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0221</GUID>
          <Name>event_date</Name>
          <Type>DateTime</Type>
          <DisplayName>Period (checked and not executed since)</DisplayName>
          <PivotPosition>Row</PivotPosition>
          <TypeEd>DateTime</TypeEd>
          <Prompt>PromptOneValue</Prompt>
          <Operator>GreaterEqual</Operator>
          <OperatorStyle>NotModifiable</OperatorStyle>
          <DisplayOrderRE>0</DisplayOrderRE>
          <Value1 />
          <Date1Keyword>Today-90D</Date1Keyword>
          <TypeRe>DateTime</TypeRe>
        </ReportRestriction>
      </CommonRestrictions>
      <Alias>Master</Alias>
      <Elements>
        <ReportElement>
          <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0201</GUID>
          <Name>report_path</Name>
          <DisplayName />
          <PivotPosition>Row</PivotPosition>
          <MetaColumnGUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0211</MetaColumnGUID>
        </ReportElement>
        <ReportElement>
          <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0202</GUID>
          <Name>report_name</Name>
          <DisplayName />
          <PivotPosition>Row</PivotPosition>
          <MetaColumnGUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0212</MetaColumnGUID>
        </ReportElement>
        <ReportElement>
          <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0203</GUID>
          <Name>last_check</Name>
          <DisplayName />
          <Format>G</Format>
          <PivotPosition>Row</PivotPosition>
          <MetaColumnGUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0213</MetaColumnGUID>
        </ReportElement>
      </Elements>
      <Table>
        <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0210</GUID>
        <Sql>SELECT
  c.event_path AS report_path,
  MAX(c.execution_name) AS report_name,
  MAX(c.event_date) AS last_check
FROM sr_audit c
WHERE c.event_type = 'ReportCheck'
AND {CommonRestriction_event_date}
AND NOT EXISTS (
  SELECT 1 FROM sr_audit e
  WHERE e.event_path = c.event_path
  AND e.event_type IN ('ReportExecution', 'ReportExecutionError', 'ReportExport')
  AND e.execution_context &lt;&gt; 'TaskScheduler'
  AND {CommonRestriction_event_date}
)
GROUP BY c.event_path</Sql>
        <Alias>Master</Alias>
        <DynamicColumns>true</DynamicColumns>
        <Columns>
          <MetaColumn>
            <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0211</GUID>
            <Name>report_path</Name>
            <Type>Text</Type>
            <Category>Never executed</Category>
            <DisplayName>Report path</DisplayName>
          </MetaColumn>
          <MetaColumn>
            <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0212</GUID>
            <Name>report_name</Name>
            <Type>Text</Type>
            <Category>Never executed</Category>
            <DisplayName>Report name</DisplayName>
            <DisplayOrder>2</DisplayOrder>
          </MetaColumn>
          <MetaColumn>
            <GUID>4c0e9b1d-6a2f-4e8b-b7d3-1f5a9c2e0213</GUID>
            <Name>last_check</Name>
            <Type>DateTime</Type>
            <Category>Never executed</Category>
            <DisplayName>Last check</DisplayName>
            <DisplayOrder>3</DisplayOrder>
          </MetaColumn>
        </Columns>
      </Table>
