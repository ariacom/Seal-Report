<?xml version="1.0"?>
<Report xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <GUID>b1a7c010-0170-4b00-9000-000000000001</GUID>
  <Guide>&lt;ul&gt;
&lt;li&gt;Expected report (pattern) of the AI test TST170 AI Complete dashboard, copy of the TST040 dashboard (Tests\Reports).&lt;/li&gt;
&lt;li&gt;Tab Control with 3 pages: Overview (widgets with a KPI, a pie chart and a bar chart, cards), Map (Leaflet map and data table), Details (page tables and data tables).&lt;/li&gt;
&lt;li&gt;An Internet connection is required to display the background tiles of the map.&lt;/li&gt;
&lt;/ul&gt;</Guide>
  <ViewGUID>b1a7c010-0170-4b00-9000-000000000501</ViewGUID>
  <Sources>
    <ReportSource>
      <GUID>b1a7c010-0170-4b00-9000-000000000101</GUID>
      <Name>Northwind (Repository)</Name>
      <ConnectionGUID>1</ConnectionGUID>
      <MetaData>
        <Tables>
          <MetaTable>
            <GUID>b1a7c010-0170-4b00-9000-000000000111</GUID>
            <Alias>SealMasterTable</Alias>
            <DynamicColumns>true</DynamicColumns>
          </MetaTable>
          <MetaTable>
            <GUID>b1a7c010-0170-4b00-9000-000000000112</GUID>
            <Description>Coordinates of some customer cities (WGS84 decimal degrees), Northwind has no geographical data.</Description>
            <Sql>SELECT N'Bruxelles' AS City, 50.8503 AS Latitude, 4.3517 AS Longitude
UNION ALL SELECT N'Charleroi', 50.4108, 4.4446
UNION ALL SELECT N'Lille', 50.6292, 3.0573
UNION ALL SELECT N'Lyon', 45.7640, 4.8357
UNION ALL SELECT N'Marseille', 43.2965, 5.3698
UNION ALL SELECT N'Nantes', 47.2184, -1.5536
UNION ALL SELECT N'Paris', 48.8566, 2.3522
UNION ALL SELECT N'Reims', 49.2583, 4.0317
UNION ALL SELECT N'Strasbourg', 48.5734, 7.7521
UNION ALL SELECT N'Toulouse', 43.6047, 1.4442
UNION ALL SELECT N'Versailles', 48.8049, 2.1204
UNION ALL SELECT N'Bern', 46.9480, 7.4474
UNION ALL SELECT N'Genève', 46.2044, 6.1432</Sql>
            <Alias>Cities</Alias>
            <Columns>
              <MetaColumn>
                <GUID>b1a7c010-0170-4b00-9000-000000000121</GUID>
                <Name>Cities.City</Name>
                <Type>Text</Type>
                <Category>Cities</Category>
                <DisplayName>Map City</DisplayName>
              </MetaColumn>
              <MetaColumn>
                <GUID>b1a7c010-0170-4b00-9000-000000000122</GUID>
                <Name>Cities.Latitude</Name>
                <Type>Numeric</Type>
                <Category>Cities</Category>
                <DisplayName>Latitude</DisplayName>
                <DisplayOrder>2</DisplayOrder>
                <NumericStandardFormat>Custom</NumericStandardFormat>
                <Format>0.0000</Format>
              </MetaColumn>
              <MetaColumn>
                <GUID>b1a7c010-0170-4b00-9000-000000000123</GUID>
                <Name>Cities.Longitude</Name>
                <Type>Numeric</Type>
                <Category>Cities</Category>
                <DisplayName>Longitude</DisplayName>
                <DisplayOrder>3</DisplayOrder>
                <NumericStandardFormat>Custom</NumericStandardFormat>
                <Format>0.0000</Format>
              </MetaColumn>
            </Columns>
          </MetaTable>
        </Tables>
        <Joins>
          <MetaJoin>
            <GUID>b1a7c010-0170-4b00-9000-000000000131</GUID>
            <Name>Customers - Cities</Name>
            <LeftTableGUID>b7b15abd-c099-42f9-a31d-88ce660ed1de</LeftTableGUID>
            <RightTableGUID>b1a7c010-0170-4b00-9000-000000000112</RightTableGUID>
            <Clause>Customers.City = Cities.City</Clause>
          </MetaJoin>
        </Joins>
      </MetaData>
