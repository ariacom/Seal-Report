<?xml version="1.0"?>
<Report xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <GUID>16d50a74-b77f-49e5-8fb6-996039461f04</GUID>
  <DisplayName>@{
    //Title set by the Web Report Server (SWIExecuteReportExecutions): 'Executions - report name'
    Report report = Model;
    string result = report.Tag2 as string;
    if (string.IsNullOrEmpty(result)) result = report.Translate("Report Executions");
}
@Raw(result)</DisplayName>
  <ViewGUID>8faccb5e-fb09-4b72-ac55-f5e1353ff2c2</ViewGUID>
  <Sources>
    <ReportSource>
      <GUID>f3077b0b-305a-4eaf-9a13-d8103ff345bf</GUID>
      <Name>Audit</Name>
      <ConnectionGUID>1</ConnectionGUID>
      <MetaData>
        <Tables>
          <MetaTable>
            <GUID>f7c38212-f7ca-4799-bdbd-fcb5b7444b65</GUID>
            <Sql>select * from sr_audit</Sql>
            <Alias>sr_executions</Alias>
            <WhereSQL>@{
    //Executions of the logged user only, for the report set by the Web Report Server (SWIExecuteReportExecutions): nothing is returned otherwise
    MetaTable table = Model;
    string result = "1=0";
    Report report = table.Source.Report;
    if (report != null &amp;&amp; report.SecurityContext != null &amp;&amp; !string.IsNullOrEmpty(report.SecurityContext.Name) &amp;&amp; report.Tag is string reportPath &amp;&amp; !string.IsNullOrEmpty(reportPath))
    {
        result = string.Format("event_type in ('ReportExecution','ReportExecutionError') AND user_name={0} AND event_path={1}", Helper.QuoteSingle(report.SecurityContext.Name), Helper.QuoteSingle(reportPath));
    }
}
@Raw(result)</WhereSQL>
