@using ClosedXML.Excel
@using System.IO
@using Seal.Model
@using Seal.Renderer
@{
    Report report = Model;
    ReportView view = report.CurrentView;

    ExcelRenderer renderer = view.ExcelRenderer;
    ExcelResult result = new ExcelResult(report);

    //Init Excel Result
    using (result.Workbook = new XLWorkbook())
    {
        result.AddWorksheet(report.ExecutionName);

        //Summary
        if (report.ExecutionView.HasValue("report_summary"))
        {
            var summaryCells = result.Worksheet.Range(1, 1, 5, 10);
            summaryCells.Merge();
            summaryCells.Style.Alignment.WrapText = true;
            summaryCells.Style.Alignment.Vertical = XLAlignmentVerticalValues.Top;
            summaryCells.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left;
            result.SetHtmlValue(summaryCells, report.ExecutionView.GetValue("report_summary"));
            result.CurrentRow = 6;
        }

        view.ParseChildren();

        result.CleanWorkbook();

        //Report information
        if (renderer.GetBoolValue("show_information"))
        {
            result.AddWorksheet(report.Translate("Information"));
            showInformation(renderer);
        }

        //Final options
        foreach (IXLWorksheet sheet in result.Workbook.Worksheets.Where(i => i.LastCellUsed() != null))
        {
            //Auto fit
            if (renderer.GetBoolValue("auto_fit_columns")) sheet.Columns().AdjustToContents();

            //Printer
            sheet.PageSetup.PaperSize = ExcelResult.GetPaperSize(renderer.GetValue("printer_paper_size"));
            sheet.PageSetup.PageOrientation = ExcelResult.GetPageOrientation(renderer.GetValue("printer_orientation"));
            if (renderer.GetBoolValue("printer_fit_page"))
            {
                sheet.PageSetup.FitToPages(renderer.GetNumericValue("printer_fit_width"), renderer.GetNumericValue("printer_fit_height"));
            }
            sheet.PageSetup.Margins.Left = 0.314;
            sheet.PageSetup.Margins.Right = 0.314;
            sheet.PageSetup.Margins.Top = 0.59;
            sheet.PageSetup.Margins.Bottom = 0.59;
            sheet.PageSetup.Margins.Header = 0.314;
            sheet.PageSetup.Margins.Footer = 0.314;
        }

        //Messages
        if (renderer.GetBoolValue("show_messages"))
        {
            result.AddWorksheet(report.Translate("Messages"));
            showMessages(result);
        }

        //Header & Footer
        foreach (IXLWorksheet sheet in result.Workbook.Worksheets)
        {
            var header = sheet.PageSetup.Header;
            header.Left.AddText(report.ExecutionName).SetFontSize(14).SetBold(true).SetFontName("Arial");

            var footer = sheet.PageSetup.Footer;
            footer.Right.AddText(report.Translate("Page") + " ");
            footer.Right.AddText(XLHFPredefinedText.PageNumber);
            footer.Right.AddText("/");
            footer.Right.AddText(XLHFPredefinedText.NumberOfPages);
            footer.Left.AddText(XLHFPredefinedText.Path);
            footer.Left.AddText(XLHFPredefinedText.File);
        }

        if (!report.HasErrors) result.Workbook.SaveAs(report.ResultFilePath);
    }
}

@functions {
    void showInformation(ExcelRenderer renderer)
    {
        ExcelResult result = renderer.Result;
        Report report = result.Report;
        var sheet = result.Worksheet;
        int rowStart = 1, colStart = 1;
        sheet.Cell(rowStart, 1).Value = report.DisplayNameEx ?? "";
        result.ApplyStyle(sheet.Cell(rowStart, 1), ExcelResult.CellTitleStyle);
        if (report.ExecutionView.HasValue("report_description"))
        {
            rowStart += 1;
            sheet.Cell(rowStart, 1).Value = report.ExecutionView.GetValue("report_description") ?? "";
            var infoCells = sheet.Range(rowStart, 1, rowStart + 1, 5);
            infoCells.Merge();
            infoCells.Style.Alignment.WrapText = true;
            infoCells.Style.Alignment.Vertical = XLAlignmentVerticalValues.Top;
            infoCells.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Left;
            rowStart += 1;
        }
        rowStart += 2;

        sheet.Cell(rowStart, 1).Value = report.Translate("Execution date");
        sheet.Cell(rowStart, 2).Value = report.ExecutionStartDate;
        sheet.Range(rowStart, 2, rowStart, 4).Merge();
        sheet.Cell(rowStart, 2).Style.NumberFormat.Format = report.CultureInfo.DateTimeFormat.ShortDatePattern + " " + report.CultureInfo.DateTimeFormat.LongTimePattern;
        rowStart++;
        sheet.Cell(rowStart, 1).Value = report.Translate("Execution duration");
        sheet.Range(rowStart, 2, rowStart, 4).Merge();
        sheet.Cell(rowStart, 2).Value = Math.Floor(report.ExecutionModelDuration.TotalSeconds);
        result.ApplyStyle(sheet.Range(rowStart - 1, 1, rowStart, 1), ExcelResult.CellTitleStyle);

        rowStart += 2;
        sheet.Cell(rowStart, colStart++).Value = report.Translate("Model");
        sheet.Cell(rowStart, colStart++).Value = report.Translate("Records");
        sheet.Cell(rowStart, colStart++).Value = report.Translate("Pages");
        sheet.Cell(rowStart, colStart++).Value = report.Translate("Duration (seconds)");
        sheet.Cell(rowStart, colStart++).Value = report.Translate("Restrictions");
        result.ApplyStyle(sheet.Range(rowStart, colStart - 5, rowStart, colStart), ExcelResult.CellTitleStyle);
        rowStart++;
        foreach (var item in report.Models.Where(i => i.ResultTable != null && i.Pages != null))
        {
            colStart = result.CurrentCol;
            sheet.Cell(rowStart, colStart++).Value = item.Name + "(" + item.Connection.Name + ")";
            sheet.Cell(rowStart, colStart++).Value = item.ResultTable.Rows.Count;
            sheet.Cell(rowStart, colStart++).Value = item.Pages.Count;
            sheet.Cell(rowStart, colStart++).Value = item.ExecutionDuration;
            sheet.Cell(rowStart, colStart).Value = item.RestrictionText ?? "";
            sheet.Cell(rowStart, colStart++).Style.Alignment.WrapText = true;
            rowStart++;
        }

        sheet.Columns().AdjustToContents();
        var usedRange = sheet.RangeUsed();
        if (usedRange != null) usedRange.Style.Alignment.Vertical = XLAlignmentVerticalValues.Top;
        sheet.Column(5).Width = 60;
    }

    void showMessages(ExcelResult result)
    {
        Report report = result.Report;
        var sheet = result.Worksheet;
        sheet.Cell(result.CurrentRow, result.CurrentCol).Value = report.ExecutionMessages.Trim();
        sheet.Cell(result.CurrentRow, result.CurrentCol).Style.Alignment.WrapText = true;
        sheet.Column(result.CurrentCol).Width = 80;
    }
}
