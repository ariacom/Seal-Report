@using ClosedXML.Excel
@using Seal.Model;
@{
    ReportViewTemplate Template = Model;

    //Parameters for this template
    Template.Parameters.Add(new Parameter() { Name = "show_information", DisplayName = "Show report information", BoolValue = true, ShowInResultOptions = true, Description = "If true, report information is displayed in a dedicated sheet." });
    Template.Parameters.Add(new Parameter() { Name = "show_messages", DisplayName = "Show messages", BoolValue = false, ShowInResultOptions = true, Description = "If true, report execution messages are displayed in a dedicated sheet." });
    Template.Parameters.Add(new Parameter() { Name = "auto_fit_columns", DisplayName = "Auto Fit columns", BoolValue = true, ShowInResultOptions = true, Description = "If true, columns widths are ajusted with the cell content." });
    Template.Parameters.Add(new Parameter()
            {
                Name = "printer_paper_size",
                DisplayName = "Print: Paper size",
                Description = "Define the size of the paper when printing the document.",
                Value = "A4Paper",
                UseOnlyEnumValues = true,
                Enums = new string[] { },
                EnumType = typeof(XLPaperSize)
            });
    Template.Parameters.Add(new Parameter()
            {
                Name = "printer_orientation",
                DisplayName = "Print: Page orientation",
                Description = "Define the page orientation when printing the document.",
                Value = "Portrait",
                ShowInResultOptions = true,
                UseOnlyEnumValues = true,
                Enums = new string[] { },
                EnumType = typeof(XLPageOrientation)
            });
    Template.Parameters.Add(new Parameter() { Name = "printer_fit_page", DisplayName = "Print: Fit to page", BoolValue = true, Description = "If true, the pages are adapted to the paper size when printing." });
    Template.Parameters.Add(new Parameter() { Name = "printer_fit_width", DisplayName = "Print: Fit to width", NumericValue = 1, Description = "If 'Fit to page' is true, number of pages to fit in width, 0 for automatic." });
    Template.Parameters.Add(new Parameter() { Name = "printer_fit_height", DisplayName = "Print: Fit to height", NumericValue = 0, Description = "If 'Fit to page' is true, number of pages to fit in height, 0 for automatic." });
    Template.Parameters.Add(new Parameter() { Name = "header_logo", DisplayName = "Print: Logo in header", BoolValue = true, ShowInResultOptions = true, Description = "If true, the logo is shown in the page header of the sheets (visible when printing and in the page layout view)." });
    Template.Parameters.Add(new Parameter() { Name = "header_logo_file", DisplayName = "Print: Logo file", Value = "", Description = "PNG or JPG file of the logo shown in the page header: file name in the Repository folder '<Repository Path>\\Views\\img' or full path. If empty, the logo of the server configuration is used. Excel does not accept a SVG in a page header: a '.svg' is replaced by the '.png' or '.jpg' file of the same name." });
    Template.Parameters.Add(new Parameter() { Name = "header_logo_height", DisplayName = "Print: Logo height", NumericValue = 30, Description = "Maximum height of the logo in the page header, in points (the width keeps the proportions of the image, 150 points maximum). The top margin of the page is increased accordingly." });
    Template.Parameters.Add(new Parameter()
            {
                Name = "header_logo_position",
                DisplayName = "Print: Logo position",
                Description = "Position of the logo in the page header. The report name is shown on the left.",
                Value = "Right",
                UseOnlyEnumValues = true,
                Enums = new string[] { "Left", "Center", "Right" }
            });

}
