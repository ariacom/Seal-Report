@using Seal.Model
@using Seal.Helpers
@{
    Report report = Model;
    ReportView view = report.CurrentView;
    ReportModel reportModel = view.Model;

    string separator = view.CSVRenderer.GetSeparator();
    CsvQuoting quoting = view.CSVRenderer.GetQuoting();
    string newLine = view.CSVRenderer.GetLineEnding();
    bool useFormat = view.CSVRenderer.GetBoolValue("use_display_format", true);
    bool invariantRaw = view.CSVRenderer.GetBoolValue("csv_invariant_raw", false);
    bool addLastSeparator = view.CSVRenderer.GetBoolValue("add_last_separator", false);

    //CSV value of a cell followed by the separator (except for the last value of the line if 'Add last separator' is false)
    Func<ResultCell, bool, bool, string> csvValue = (cell, format, isLast) => cell.CSVValue(format, (!addLastSeparator && isLast) ? "" : separator, quoting, invariantRaw);
}
@foreach (ResultPage page in reportModel.Pages)
{
    if (page.PageTable != null && view.GetBoolValue("show_page_tables") && page.PageTable.RowCount == 2 && page.PageTable.ColumnCount > 0)
    {
        for (int i = 0; i < page.PageTable.ColumnCount; i++)
        {
            ResultCell header = page.PageTable[0,i];
            ResultCell value = page.PageTable[1,i];
            @Raw(csvValue(header, false, false) + csvValue(value, useFormat, i == page.PageTable.ColumnCount - 1) + newLine)
        }
    }
    if (page.DataTable != null && view.GetBoolValue("show_data_tables"))
    {
        for (int row = 0; row < page.DataTable.RowCount; row++)
        {
            for (int col = 0; col < page.DataTable.ColumnCount; col++)
            {
                @Raw(csvValue(page.DataTable[row, col], useFormat, col == page.DataTable.ColumnCount - 1))
            }
            @Raw(newLine)
        }
    }
    @Raw(newLine)
}