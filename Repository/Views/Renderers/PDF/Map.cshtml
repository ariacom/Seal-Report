@using QuestPDF.Fluent
@using QuestPDF.Infrastructure
@using Seal.Model
@using Seal.Renderer

@{
    Report report = Model;
    ReportView view = report.CurrentView;

    PDFRenderer renderer = view.PDFRenderer;
    PDFResult result = report.PDFResult;
    ResultPage page = report.CurrentPage;

    var container = result.Container;

    try
    {
        //The picture of the map (with its tiles, points and legend) is taken from the HTML result shown in the headless browser
        //The views are parsed in the same order as in the HTML result: the first identifier left is the one of this view
        var identifiers = page.GetIdentifiers(ResultPageIdentifierType.MapContainer);
        foreach (var id in identifiers.Take(1).ToList())
        {
            if (result.Page == null) break;
            var image = await HeadlessBrowser.GetElementPicture(result.Page, "#" + id);
            if (image == null) continue;

            container.Column(column =>
            {
                var i = column.Item()
                .AlignCenter()
                .AlignMiddle();
                var w = renderer.GetNumericValue("map_width");
                if (w > 0) i = i.Width(w, Unit.Millimetre);
                var h = renderer.GetNumericValue("map_height");
                if (h > 0) i = i.Height(h, Unit.Millimetre);
                i.Image(image).FitArea();

                container = column.Item();
            });
        }
        if (identifiers.Count > 0) identifiers.RemoveAt(0);
    }
    catch (Exception ex)
    {
        report.LogMessage(ex.Message);
    }
}
