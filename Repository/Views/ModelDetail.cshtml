@using Seal.Model
@using Seal.Helpers
@{
    Report report = Model;
    ReportView view = report.CurrentView;
    ReportModel reportModel = view.Model;
    bool showNavigation = view.GetBoolValue("modeldetail_show_navigation");
    string navigationIcon = "<span class='navigation_icon fa-solid fa-up-right-from-square'></span>";
}

@if (report.Format == ReportFormat.csv)
{
    @Include(view.GetPartialTemplateKey("ModelDetail.iCSV", view), view)
}
else
{
<div id='@("model_" + view.IdSuffix)' viewid='@view.ViewId' @Raw(view.AddAttribute("class", "modeldetail_class")) @Raw(view.AddAttribute("style", "modeldetail_css"))>

    @foreach (ResultPage page in reportModel.Pages)
    {
        <div>
            @if (page.PageTable != null && page.PageTable.RowCount == 2 && page.PageTable.ColumnCount > 0)
            {
                <table class='table table-striped table-hover table-bordered' @Raw(view.AddAttribute("style", "pagetable_css"))>
                    <tr>
                        @for (int i = 0; i < page.PageTable.ColumnCount; i++)
                        {
                            ResultCell value = page.PageTable[1, i];
                            string navigation = reportModel.GetNavigation(view, value);
                            <th @Raw(Helper.AddAttribute("class", value.CellCssDetailClass)) @Raw(Helper.AddAttribute("style", value.CellCssDetailStyle)) @Raw(navigation)>@Raw(value.HTMLValue) @Raw(showNavigation && !string.IsNullOrEmpty(navigation) ? navigationIcon : "")</th>
                        }
                    </tr>
                </table>

                <hr style="display: block;" />
            }


            @if (page.DataTable != null && page.DataTable.RowCount == 2)
            {
                <table class='table table-striped table-hover table-bordered' @Raw(view.AddAttribute("style", "datatable_css"))>
                    @for (int i = 0; i < page.DataTable.ColumnCount; i++)
                    {
                        ResultCell title = page.DataTable[0, i];
                        ResultCell value = page.DataTable[1, i];
                        string navigation = reportModel.GetNavigation(view, value);
                        <tr>
                                <th @Raw(Helper.AddAttribute("class", title.CellCssDetailClass)) @Raw(Helper.AddAttribute("style", title.CellCssDetailStyle)) @Raw(view.HeaderInformationAttribute(title, "modeldetail_show_header_information", "modeldetail_header_information_style"))>@Raw(title.HTMLValue)@Raw(view.HeaderInformationHTML(title, "modeldetail_show_header_information", "modeldetail_header_information_style")) @Raw(showNavigation && !string.IsNullOrEmpty(navigation) ? navigationIcon : "")</th>
                                <td @Raw(Helper.AddAttribute("class", value.CellCssDetailClass)) @Raw(Helper.AddAttribute("style", value.CellCssDetailStyle)) @Raw(navigation)>@Raw(value.HTMLValue)</td>
                        </tr>
                    }
                </table>
                @Raw(view.HeaderInformationNotes())
            }
        </div>
    }
</div>
}
